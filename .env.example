# نمونه متغیرهای محیطی Ravix — این فایل را به .env کپی و مقادیر را تنظیم کنید.
# هرگز فایل .env را در مخزن کد قرار ندهید.

# development یا production
DJANGO_SETTINGS_MODULE=config.settings.development

# حداقل ۳۲ کاراکتر تصادفی. تولید: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# هاست‌های مجاز (با کاما جدا شوند) — در production الزامی است
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# مثال: https://cms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# خالی = SQLite (db.sqlite3). برای PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ravix
DATABASE_URL=

# ثبت‌نام عمومی در اولین راه‌اندازی (بعداً از «تنظیمات سایت» قابل تغییر است)
RAVIX_REGISTRATION_OPEN=false

# بررسی «انسان‌بودن» خودمیزبان (proof-of-work): ثبت‌نام، بازیابی رمز و ارسال دوبارهٔ تأیید همیشه؛ ورود فقط پس از چند تلاش ناموفق.
# RAVIX_CAPTCHA_ENABLED=true
# RAVIX_CAPTCHA_BITS=18               # هر بیت اضافه، کار مرورگر را دو برابر می‌کند (۱۸ ≈ کمتر از یک ثانیه)
# RAVIX_CAPTCHA_LOGIN_AFTER=3         # تعداد ناموفق‌ها (همان IP و حساب) تا نمایش بررسی در ورود
# RAVIX_REGISTER_LIMIT_PER_IP=10      # ثبت‌نام در هر ساعت برای هر IP

# فقط production
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# فقط وقتی همهٔ زیردامنه‌ها هم HTTPS دارند و می‌خواهید در فهرست preload مرورگرها بروید روشن کنید (برگشت‌ناپذیر است):
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Ravix <noreply@example.com>
# EMAIL_TIMEOUT=10
# آزمودن SMTP:  python manage.py send_test_email you@example.com
# RAVIX_REQUIRE_EMAIL_VERIFICATION=false   # true: ورود تا تأیید ایمیل ممکن نیست (فقط پس از موفقیت send_test_email). همین گزینه را مدیر در پنل ← تنظیمات حساب‌ها هم می‌تواند روشن کند؛ متغیر، آن را اجباری می‌کند
# RAVIX_MAIL_LIMIT_PER_EMAIL=3
# RAVIX_MAIL_LIMIT_PER_IP=10

# --- سایت عمومی و قالب‌ها (اختیاری) ---
# نشانی اصلی سایت برای canonical، sitemap و Open Graph (خالی = از Host درخواست)
RAVIX_SITE_URL=
# مسیرهای اضافه برای پوشهٔ قالب‌ها، جداشده با ویرگول (قالب‌های پروژه در themes/ هستند)
RAVIX_EXTRA_THEME_DIRS=
# تعداد نوشته در هر صفحهٔ فهرست
RAVIX_PUBLIC_PAGE_SIZE=9
# تعداد نوشته در هر فید RSS/Atom (۱ تا ۱۰۰)
RAVIX_FEED_ITEMS=20
# کش مرورگر/CDN برای صفحات عمومی بازدیدکنندگان ناشناس (ثانیه؛ ۰ = همیشه با ETag بازبینی)
RAVIX_PUBLIC_CACHE_SECONDS=0
# کش مرورگر برای فایل‌های استاتیک در production (ثانیه)
RAVIX_STATIC_MAX_AGE=3600

# --- افزونه‌ها ---
# RAVIX_PLUGINS_ENABLED=true          # false: سیستم افزونه کاملاً خاموش
# RAVIX_PLUGINS_SAFE_MODE=false       # true: کد هیچ افزونه‌ای اجرا نمی‌شود (برای بازیابی)
# RAVIX_EXTRA_PLUGIN_DIRS=            # پوشه‌های اضافهٔ افزونه (با کاما)؛ فقط مسیرهای مورد اعتماد
# RAVIX_PLUGIN_ERROR_LIMIT=5          # این تعداد خطا در بازهٔ زیر ← غیرفعال‌سازی خودکار
# RAVIX_PLUGIN_ERROR_WINDOW=600

# --- چندسایتی و فروشگاه (مرحله ششم) ---
# false: فقط سایت پیش‌فرض (رفتار تک‌سایتی). true: تشخیص سایت از دامنه + عضویت الزامی در پنل
# RAVIX_MULTISITE_ENABLED=false
# RAVIX_SHOP_ENABLED=true          # false = فروشگاه کاملاً خاموش (بدون جدول/مسیر/منو)
# RAVIX_SHOP_ALLOW_GUEST_CHECKOUT=true
# RAVIX_SHOP_PRIVATE_ROOT=         # پوشهٔ خصوصی فایل دیجیتال (پیش‌فرض: shop_private/)
# RAVIX_SHOP_DIGITAL_MAX_BYTES=209715200
# RAVIX_SHOP_DIGITAL_DOWNLOAD_LIMIT=5
# RAVIX_SHOP_CURRENCY_LABEL=تومان
# فعلاً فقط sandbox (آزمایشی) وجود دارد. درگاه واقعی بدون نوشتن آداپتور و اطلاعات مرچنت متصل نیست.
# RAVIX_SHOP_PAYMENT_GATEWAY=sandbox   # درگاه پیش‌فرض/توسعه؛ فعال‌سازی درگاه‌ها در پنل: فروشگاه ← درگاه‌های پرداخت
# RAVIX_SHOP_CURRENCY_CODE=IRT         # IRT تومان | IRR ریال (درگاه باید پشتیبانی کند)
# کلید رمزنگاری اسرار درگاه‌ها (Fernet). تولید: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# چرخش: کلید جدید را اول، کلید قبلی را بعد از آن بگذارید (با ویرگول)
# RAVIX_SECRETS_KEY=
# کلیدهای هر درگاه را می‌توان به‌جای دیتابیس در محیط گذاشت و بر پنل مقدم‌اند:
# RAVIX_GATEWAY_<نام_درگاه>_<نام_فیلد>=...   مثال: RAVIX_GATEWAY_EXAMPLE_PAY_API_KEY=
# فقط برای دمو/استیجینگ: اجازهٔ درگاه آزمایشی با DEBUG=False. در سایت واقعی هرگز true نکنید.
# RAVIX_SHOP_ALLOW_SANDBOX_IN_PRODUCTION=false
# RAVIX_SHOP_PENDING_ORDER_MINUTES=30
# RAVIX_SHOP_PAGE_SIZE=12

# --- فقط production ---
# REDIS_URL=redis://127.0.0.1:6379/1      # اختیاری؛ در غیر این صورت کش فایلی
# RAVIX_CACHE_DIR=/var/cache/ravix
# RAVIX_LOG_LEVEL=INFO
# DJANGO_SECURE_SSL_REDIRECT=true
# DB_CONN_MAX_AGE=60

# --- مخزن افزونه‌ها ---
# RAVIX_REGISTRY_ENABLED=true
# RAVIX_REGISTRY_NAME=Ravix Plugin Registry
# مسیر ذخیرهٔ بسته‌ها: خارج از media و static؛ در تولید مثلاً /srv/ravix/registry_packages (مالک: کاربر سرویس، مجوز 750)
# RAVIX_REGISTRY_STORAGE=/srv/ravix/registry_packages
# RAVIX_REGISTRY_MAX_PACKAGE_BYTES=5242880
# فقط توسعهٔ محلی؛ در تولید هرگز true نکنید (دریافت/انتشار فقط HTTPS)
# RAVIX_REGISTRY_ALLOW_INSECURE_DOWNLOAD=false
# توجه: توکن‌های ناشران در دیتابیس به‌صورت هش ذخیره می‌شوند؛ هیچ کلید ثابتی در کد یا این فایل لازم نیست.

# --- نصب‌کنندهٔ افزونه (پنل ← افزونه‌ها ← نصب از بسته) ---
# پیش‌فرض خاموش. فقط وقتی روشن کنید که پوشهٔ نصب را برای کاربر سرویس قابل‌نوشتن کرده‌اید. افزونه = کد قابل اجرا روی سرور.
# RAVIX_PLUGIN_WEB_INSTALL=false
# RAVIX_PLUGIN_INSTALL_DIR=/srv/ravix/plugins_installed      # قابل‌نوشتن برای سرویس؛ پوشهٔ plugins/ کد پروژه فقط‌خواندنی بماند
# RAVIX_PLUGIN_BACKUP_DIR=/srv/ravix/plugin_backups          # پشتیبان نسخهٔ قبلی پیش از ارتقا (مجوز 700)
# RAVIX_PLUGIN_BACKUPS_KEEP=5
# مخزن رسمی افزونه و قالب: پیش‌فرض https://plugins.ravixcms.com است (apps/core/official.py). تا وقتی هیچ کلید عمومی مورد اعتمادی تنظیم نشده، غیرفعال می‌ماند.
# برای مخزن دیگر مقدار بدهید؛ مقدار خالی صریح آن را خاموش می‌کند (آن‌گاه مخزن همین نمونه، اگر روشن باشد).
# RAVIX_OFFICIAL_REGISTRY_URL=https://plugins.ravixcms.com
# کلیدهای عمومی مورد اعتماد امضا: «برچسب:دامنه:کلید_base64» با ویرگول. دامنه: plugin (بستهٔ افزونه)، core (به‌روزرسانی هسته) یا plugin+core.
# (فقط کلید عمومی؛ کلیدهای رسمی به‌روزرسانی هسته داخل کد هستند؛ کلیدهای بیشتر را مدیرکل در پنل ثبت می‌کند)
# RAVIX_TRUSTED_PUBLIC_KEYS=publisher:plugin:BASE64_PUBLIC_KEY
# پذیرش آپلود محلی بدون امضا (بسته‌های مخزن همیشه امضا می‌خواهند). توصیه: false
# RAVIX_PLUGINS_ALLOW_UNSIGNED=false
# --- فقط روی سرور مخزن: کلید امضای نسخه‌ها. هرگز در مخزن کد نگذارید. ---
# بهتر: فایل با مجوز 600 خارج از پروژه (ساخت: manage.py plugin_keygen --out /etc/ravix/registry-signing.key)
# RAVIX_REGISTRY_SIGNING_KEY_FILE=/etc/ravix/registry-signing.key

# --- به‌روزرسانی یکپارچه (هسته/قالب/افزونه) — docs/upgrade.md ---
# منبع رسمی پیش‌فرض: https://updates.ravixcms.com (apps/core/official.py). تا وقتی هیچ کلید عمومی مورد اعتمادی (RAVIX_TRUSTED_PUBLIC_KEYS) تنظیم نشده
# غیرفعال است و پنل/«سلامت سایت» با پیام روشن (نه خطا) همین را می‌گویند. برای منبع خودتان مقدار بدهید یا با مقدار خالی خاموشش کنید.
# RAVIX_UPDATE_URL=https://updates.ravixcms.com        # فقط HTTPS؛ <URL>/updates/v1/index.json
# RAVIX_UPDATE_DIR=/srv/ravix/update_source            # جایگزین آفلاین: پوشهٔ index.json + بسته‌ها
# پیوندهای پروژه در پاورقی پنل و نصب‌کننده (همه اختیاری):
# RAVIX_WEBSITE_URL=https://ravixcms.com
# RAVIX_DOCS_URL=https://ravixcms.com/docs
# RAVIX_REPO_URL=https://github.com/ravixcms/ravixcms
# اعمال از پنل (پیش‌فرض خاموش؛ دستور ravix_update همیشه در دسترس است). فقط وقتی روشن کنید که سرویس وب مجوز نوشتن روی کد را دارد.
# RAVIX_UPDATE_WEB_APPLY=false
# RAVIX_UPDATE_BACKUP_DIR=/srv/ravix/update_backups    # مجوز 700؛ خارج از media
# RAVIX_UPDATE_WORK_DIR=/srv/ravix/update_work         # دریافت/استخراج موقت؛ بهتر است روی همان فایل‌سیستم کد باشد
# RAVIX_UPDATE_BACKUPS_KEEP=3
# RAVIX_UPDATE_REQUIRE_SIGNED_INDEX=false              # true: فهرست هم باید index.json.sig داشته باشد
# کلیدهای امضا همان RAVIX_TRUSTED_PUBLIC_KEYS (فقط کلید عمومی) هستند. کلید خصوصی هرگز در سرور سایت لازم نیست.

# --- امنیت و استقرار (انتشار عمومی) ---
# مسیر پنل مدیریت Django (پیش‌فرض django-admin، فقط مدیرکل). برای کم‌کردن اسکن خودکار تغییرش دهید.
# RAVIX_ADMIN_PATH=django-admin
# IP کلاینت (برای محدودیت ورود/دیدگاه/ایمیل): پشت Nginx روی سوکت یونیکس (چیدمان پیشنهادی) هیچ تنظیمی لازم نیست.
# فقط اگر پروکسی شما روی TCP به برنامه وصل می‌شود، نشانی/شبکهٔ آن را (با کاما) بنویسید، مثلاً 127.0.0.1 یا 10.0.0.0/8.
# هدرهای X-Forwarded-For / X-Real-IP فقط از این پروکسی‌ها پذیرفته می‌شوند (و راست‌ترین IP غیرمورداعتماد خوانده می‌شود).
# RAVIX_TRUSTED_PROXIES=
# سیاست CSP برای پاسخ‌هایی که خودشان CSP ندارند (پنل)؛ خالی = پیش‌فرض سخت‌گیرانه
# RAVIX_CSP=
# true: فقط گزارش (Content-Security-Policy-Report-Only)، برای آزمودن سیاست جدید
# RAVIX_CSP_REPORT_ONLY=false
# کلید رمزنگاری اسرار ذخیره‌شده (مثل اطلاعات درگاه). جدا از DJANGO_SECRET_KEY نگه دارید و پشتیبان امن بگیرید.
# RAVIX_SECRETS_KEY=
# پوشهٔ کش فایل در تولید (باید برای کاربر سرویس قابل‌نوشتن باشد)
# RAVIX_CACHE_DIR=/var/cache/ravix

# --- نصب قالب از فایل ZIP در پنل (فقط مدیرکل) — docs/themes.md ---
# پیش‌فرض خاموش. فقط وقتی روشن کنید که پوشهٔ نصب را جدا از کد و برای کاربر سرویس قابل‌نوشتن کرده‌اید (دیسک محلی؛ NFS/CIFS برای قفل مناسب نیست).
# RAVIX_THEME_WEB_INSTALL=false
# RAVIX_THEME_INSTALL_DIR=/srv/ravix/themes_installed   # مجوز 750 و مالک کاربر سرویس
# پس از هر نصب، مدیر سرور باید یک بار «manage.py collectstatic --noinput» اجرا کند (نصب از وب آن را اجرا نمی‌کند).

# --- نصب‌کنندهٔ وب (apps/installer، docs/installer.md) ---
# تا ساخته‌شدن مدیرکل همه‌چیز به /install/ می‌رود و بعد از آن برای همیشه ۴۰۴ می‌شود. در production برای ورود به آن توکن لازم است.
# RAVIX_INSTALL_TOKEN=          # خالی ⇒ توکن تصادفی در لاگ و فایل RAVIX_INSTALL_TOKEN_FILE؛ دیدن: python manage.py ravix_install_token
# RAVIX_INSTALL_TOKEN_FILE=
# RAVIX_INSTALLER_ENABLED=true  # false: صفحهٔ نصب کلاً خاموش (فقط createsuperuser / ravix_install)
# RAVIX_SECRET_KEY_FILE=        # کلید Django از فایل (مثل Docker secrets) اگر DJANGO_SECRET_KEY خالی باشد

# Language of operator-facing text: management commands, preflight, start-up errors and logs.
# English by default; "fa" shows them in Persian. Only RAVIX_CLI_LANG decides this (not LANGUAGE_CODE).
# Fallback language of the web interface when the site settings hold none (the site default language is set in the panel):
# LANGUAGE_CODE=en
# RAVIX_CLI_LANG=

# ── هش رمز عبور (Argon2id؛ نیازمند بستهٔ argon2-cffi) ───────────────────────────────────────────────────────────
# پیش‌فرض‌ها برای هاست اشتراکی مناسب‌اند (۶۴ مگابایت، ۳ دور، ۲ نخ). مقدارها در بازهٔ امن محدود می‌شوند.
# RAVIX_ARGON2_TIME_COST=3
# RAVIX_ARGON2_MEMORY_KIB=65536
# RAVIX_ARGON2_PARALLELISM=2
