# نمونه متغیرهای محیطی Ravin CMS — این فایل را به .env کپی و مقادیر را تنظیم کنید.
# هرگز فایل .env را در مخزن کد قرار ندهید.

# development یا production
DJANGO_SETTINGS_MODULE=config.settings.development

# حداقل ۳۲ کاراکتر تصادفی. تولید: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# هاست‌های مجاز (با کاما جدا شوند) — در production الزامی است
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# مثال: https://cms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# خالی = SQLite (db.sqlite3). برای PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ravin
DATABASE_URL=

# ثبت‌نام عمومی در اولین راه‌اندازی (بعداً از «تنظیمات سایت» قابل تغییر است)
RAVIN_REGISTRATION_OPEN=true

# فقط production
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Ravix <noreply@example.com>
# EMAIL_TIMEOUT=10
# آزمودن SMTP:  python manage.py send_test_email you@example.com
# RAVIN_REQUIRE_EMAIL_VERIFICATION=false   # true: ورود تا تأیید ایمیل ممکن نیست (فقط پس از موفقیت send_test_email)
# RAVIN_MAIL_LIMIT_PER_EMAIL=3
# RAVIN_MAIL_LIMIT_PER_IP=10

# --- سایت عمومی و قالب‌ها (اختیاری) ---
# نشانی اصلی سایت برای canonical، sitemap و Open Graph (خالی = از Host درخواست)
RAVIN_SITE_URL=
# مسیرهای اضافه برای پوشهٔ قالب‌ها، جداشده با ویرگول (قالب‌های پروژه در themes/ هستند)
RAVIN_EXTRA_THEME_DIRS=
# تعداد نوشته در هر صفحهٔ فهرست
RAVIN_PUBLIC_PAGE_SIZE=9
# تعداد نوشته در هر فید RSS/Atom (۱ تا ۱۰۰)
RAVIN_FEED_ITEMS=20
# کش مرورگر/CDN برای صفحات عمومی بازدیدکنندگان ناشناس (ثانیه؛ ۰ = همیشه با ETag بازبینی)
RAVIN_PUBLIC_CACHE_SECONDS=0
# کش مرورگر برای فایل‌های استاتیک در production (ثانیه)
RAVIN_STATIC_MAX_AGE=3600

# --- افزونه‌ها ---
# RAVIN_PLUGINS_ENABLED=true          # false: سیستم افزونه کاملاً خاموش
# RAVIN_PLUGINS_SAFE_MODE=false       # true: کد هیچ افزونه‌ای اجرا نمی‌شود (برای بازیابی)
# RAVIN_EXTRA_PLUGIN_DIRS=            # پوشه‌های اضافهٔ افزونه (با کاما)؛ فقط مسیرهای مورد اعتماد
# RAVIN_PLUGIN_ERROR_LIMIT=5          # این تعداد خطا در بازهٔ زیر ← غیرفعال‌سازی خودکار
# RAVIN_PLUGIN_ERROR_WINDOW=600

# --- چندسایتی و فروشگاه (مرحله ششم) ---
# false: فقط سایت پیش‌فرض (رفتار تک‌سایتی). true: تشخیص سایت از دامنه + عضویت الزامی در پنل
# RAVIN_MULTISITE_ENABLED=false
# RAVIN_SHOP_ENABLED=true          # false = فروشگاه کاملاً خاموش (بدون جدول/مسیر/منو)
# RAVIN_SHOP_ALLOW_GUEST_CHECKOUT=true
# RAVIN_SHOP_PRIVATE_ROOT=         # پوشهٔ خصوصی فایل دیجیتال (پیش‌فرض: shop_private/)
# RAVIN_SHOP_DIGITAL_MAX_BYTES=209715200
# RAVIN_SHOP_DIGITAL_DOWNLOAD_LIMIT=5
# RAVIN_SHOP_CURRENCY_LABEL=تومان
# فعلاً فقط sandbox (آزمایشی) وجود دارد. درگاه واقعی بدون نوشتن آداپتور و اطلاعات مرچنت متصل نیست.
# RAVIN_SHOP_PAYMENT_GATEWAY=sandbox   # درگاه پیش‌فرض/توسعه؛ فعال‌سازی درگاه‌ها در پنل: فروشگاه ← درگاه‌های پرداخت
# RAVIN_SHOP_CURRENCY_CODE=IRT         # IRT تومان | IRR ریال (درگاه باید پشتیبانی کند)
# کلید رمزنگاری اسرار درگاه‌ها (Fernet). تولید: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# چرخش: کلید جدید را اول، کلید قبلی را بعد از آن بگذارید (با ویرگول)
# RAVIN_SECRETS_KEY=
# کلیدهای هر درگاه را می‌توان به‌جای دیتابیس در محیط گذاشت و بر پنل مقدم‌اند:
# RAVIN_GATEWAY_<نام_درگاه>_<نام_فیلد>=...   مثال: RAVIN_GATEWAY_EXAMPLE_PAY_API_KEY=
# فقط برای دمو/استیجینگ: اجازهٔ درگاه آزمایشی با DEBUG=False. در سایت واقعی هرگز true نکنید.
# RAVIN_SHOP_ALLOW_SANDBOX_IN_PRODUCTION=false
# RAVIN_SHOP_PENDING_ORDER_MINUTES=30
# RAVIN_SHOP_PAGE_SIZE=12

# --- فقط production ---
# REDIS_URL=redis://127.0.0.1:6379/1      # اختیاری؛ در غیر این صورت کش فایلی
# RAVIN_CACHE_DIR=/var/cache/ravin
# RAVIN_LOG_LEVEL=INFO
# DJANGO_SECURE_SSL_REDIRECT=true
# DB_CONN_MAX_AGE=60

# --- مخزن افزونه‌ها ---
# RAVIN_REGISTRY_ENABLED=true
# RAVIN_REGISTRY_NAME=Ravin Plugin Registry
# مسیر ذخیرهٔ بسته‌ها: خارج از media و static؛ در تولید مثلاً /srv/ravin/registry_packages (مالک: کاربر سرویس، مجوز 750)
# RAVIN_REGISTRY_STORAGE=/srv/ravin/registry_packages
# RAVIN_REGISTRY_MAX_PACKAGE_BYTES=5242880
# فقط توسعهٔ محلی؛ در تولید هرگز true نکنید (دریافت/انتشار فقط HTTPS)
# RAVIN_REGISTRY_ALLOW_INSECURE_DOWNLOAD=false
# توجه: توکن‌های ناشران در دیتابیس به‌صورت هش ذخیره می‌شوند؛ هیچ کلید ثابتی در کد یا این فایل لازم نیست.

# --- نصب‌کنندهٔ افزونه (پنل ← افزونه‌ها ← نصب از بسته) ---
# پیش‌فرض خاموش. فقط وقتی روشن کنید که پوشهٔ نصب را برای کاربر سرویس قابل‌نوشتن کرده‌اید. افزونه = کد قابل اجرا روی سرور.
# RAVIN_PLUGIN_WEB_INSTALL=false
# RAVIN_PLUGIN_INSTALL_DIR=/srv/ravin/plugins_installed      # قابل‌نوشتن برای سرویس؛ پوشهٔ plugins/ کد پروژه فقط‌خواندنی بماند
# RAVIN_PLUGIN_BACKUP_DIR=/srv/ravin/plugin_backups          # پشتیبان نسخهٔ قبلی پیش از ارتقا (مجوز 700)
# RAVIN_PLUGIN_BACKUPS_KEEP=5
# نشانی مخزن رسمی (اگر مخزن شما جای دیگری است). خالی = مخزن همین نمونه. هیچ مخزن رسمی از پیش متصل نشده است.
# RAVIN_OFFICIAL_REGISTRY_URL=https://registry.example.com
# کلیدهای عمومی مورد اعتماد امضا: «برچسب:کلید_base64» با ویرگول. (فقط کلید عمومی؛ کلیدهای بیشتر را مدیرکل در پنل ثبت می‌کند)
# RAVIN_TRUSTED_PUBLIC_KEYS=publisher:BASE64_PUBLIC_KEY
# پذیرش آپلود محلی بدون امضا (بسته‌های مخزن همیشه امضا می‌خواهند). توصیه: false
# RAVIN_PLUGINS_ALLOW_UNSIGNED=false
# --- فقط روی سرور مخزن: کلید امضای نسخه‌ها. هرگز در مخزن کد نگذارید. ---
# بهتر: فایل با مجوز 600 خارج از پروژه (ساخت: manage.py plugin_keygen --out /etc/ravin/registry-signing.key)
# RAVIN_REGISTRY_SIGNING_KEY_FILE=/etc/ravin/registry-signing.key

# --- به‌روزرسانی یکپارچه (هسته/قالب/افزونه) — docs/upgrade.md ---
# هیچ منبع رسمی از پیش متصل نیست؛ باید index.json و بسته‌های امضاشده را خودتان میزبانی کنید (ravin_release).
# RAVIN_UPDATE_URL=https://updates.example.com        # فقط HTTPS؛ <URL>/updates/v1/index.json
# RAVIN_UPDATE_DIR=/srv/ravin/update_source            # جایگزین آفلاین: پوشهٔ index.json + بسته‌ها
# اعمال از پنل (پیش‌فرض خاموش؛ دستور ravin_update همیشه در دسترس است). فقط وقتی روشن کنید که سرویس وب مجوز نوشتن روی کد را دارد.
# RAVIN_UPDATE_WEB_APPLY=false
# RAVIN_UPDATE_BACKUP_DIR=/srv/ravin/update_backups    # مجوز 700؛ خارج از media
# RAVIN_UPDATE_WORK_DIR=/srv/ravin/update_work         # دریافت/استخراج موقت؛ بهتر است روی همان فایل‌سیستم کد باشد
# RAVIN_UPDATE_BACKUPS_KEEP=3
# RAVIN_UPDATE_REQUIRE_SIGNED_INDEX=false              # true: فهرست هم باید index.json.sig داشته باشد
# کلیدهای امضا همان RAVIN_TRUSTED_PUBLIC_KEYS (فقط کلید عمومی) هستند. کلید خصوصی هرگز در سرور سایت لازم نیست.

# --- امنیت و استقرار (انتشار عمومی) ---
# مسیر پنل مدیریت Django (پیش‌فرض django-admin، فقط مدیرکل). برای کم‌کردن اسکن خودکار تغییرش دهید.
# RAVIN_ADMIN_PATH=django-admin
# فقط اگر Nginx/پروکسی مورداعتماد شما هدر X-Real-IP را خودش مقدار می‌دهد true کنید.
# با true بودن بدون پروکسی، مهاجم می‌تواند IP جعلی بفرستد و محدودیت ورود را دور بزند. پیش‌فرض: false
# RAVIN_TRUST_PROXY_HEADERS=false
# سیاست CSP برای پاسخ‌هایی که خودشان CSP ندارند (پنل)؛ خالی = پیش‌فرض سخت‌گیرانه
# RAVIN_CSP=
# true: فقط گزارش (Content-Security-Policy-Report-Only)، برای آزمودن سیاست جدید
# RAVIN_CSP_REPORT_ONLY=false
# کلید رمزنگاری اسرار ذخیره‌شده (مثل اطلاعات درگاه). جدا از DJANGO_SECRET_KEY نگه دارید و پشتیبان امن بگیرید.
# RAVIN_SECRETS_KEY=
# پوشهٔ کش فایل در تولید (باید برای کاربر سرویس قابل‌نوشتن باشد)
# RAVIN_CACHE_DIR=/var/cache/ravin

# --- نصب قالب از فایل ZIP در پنل (فقط مدیرکل) — docs/themes.md ---
# پیش‌فرض خاموش. فقط وقتی روشن کنید که پوشهٔ نصب را جدا از کد و برای کاربر سرویس قابل‌نوشتن کرده‌اید (دیسک محلی؛ NFS/CIFS برای قفل مناسب نیست).
# RAVIN_THEME_WEB_INSTALL=false
# RAVIN_THEME_INSTALL_DIR=/srv/ravin/themes_installed   # مجوز 750 و مالک کاربر سرویس
# پس از هر نصب، مدیر سرور باید یک بار «manage.py collectstatic --noinput» اجرا کند (نصب از وب آن را اجرا نمی‌کند).
