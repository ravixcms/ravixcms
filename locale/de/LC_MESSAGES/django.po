msgstr "Die Dateiendung von „%(show)s“ ist in einem Theme nicht erlaubt."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "Das ZIP ist leer."

#: apps/themes/package.py
#, python-format
