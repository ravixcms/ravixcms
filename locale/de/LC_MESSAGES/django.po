#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "Eine Datei ohne Endung ist nicht erlaubt: „%(show)s“."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"Eine ausführbare Datei oder ein Skript ist in einem Theme nicht erlaubt (z. "
"B. py oder php): „%(show)s“."

