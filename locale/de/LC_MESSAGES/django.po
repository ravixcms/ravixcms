msgstr ""
"Die ZIP-Datei ist beschädigt oder unvollständig und konnte nicht geöffnet "
"werden."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "Unsicherer Name im ZIP (Backslash): „%(show)s“."

#: apps/themes/package.py
msgid "Unsafe name in ZIP (control character)."
msgstr "Unsicherer Name im ZIP (Steuerzeichen)."

#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "Absolute Pfade sind im ZIP nicht erlaubt: „%(show)s“."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr ""
"Unsicherer Pfad im ZIP (. oder .. oder ein leeres Segment): „%(show)s“."

#: apps/themes/package.py
#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "Der Pfad „%(show)s“ ist zu lang oder zu tief."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters,"
" no leading dot)."
msgstr ""
"Der Name „%(show)s“ ist nicht erlaubt; Datei- und Ordnernamen dürfen nur "
"englische Buchstaben, Ziffern, „.“, „-“ und „_“ enthalten (keine "
