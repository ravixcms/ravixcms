msgstr ""
"Doppelter Name (oder nur in der Groß-/Kleinschreibung verschieden) im ZIP: "
"„%(show)s“."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"Die Datei „%(show)s“ liegt außerhalb des Theme-Ordners. Alle Dateien müssen "
"in einem Ordner liegen, der nach der Theme-ID benannt ist (z. B. my-"
"theme/theme.json)."

#: apps/themes/package.py
#, python-format
