msgid "Layout and spacing"
msgstr "Diseño y espaciado"

#: static/builder/builder.js
msgid "Appearance"
msgstr "Apariencia"

#: static/builder/builder.js
msgid "+ Add column"
msgstr "+ Añadir columna"

#: static/builder/builder.js
msgid "At most %(n)s columns per row."
msgstr "Como máximo %(n)s columnas por fila."

#: static/builder/builder.js
msgid "Split columns equally"
msgstr "Dividir las columnas por igual"

#: static/builder/builder.js
msgid "Total width of this row’s columns: %(total)s of 12"
msgstr "Ancho total de las columnas de esta fila: %(total)s de 12"

#: static/builder/builder.js
msgid "No image found. First upload an image to the media library."
msgstr ""
"No se encontró ninguna imagen. Primero sube una imagen a la biblioteca de "
"medios."

#: static/builder/builder.js
msgid "Saved."
msgstr "Guardado."

#: static/builder/builder.js
msgid "Publish"
msgstr "Publicar"

#: static/builder/builder.js
msgid "Submit for approval"
msgstr "Enviar para aprobación"

#: static/builder/builder.js
msgid "Publish this layout on the site"
msgstr "Publicar este diseño en el sitio"

#: static/builder/builder.js
msgid "The layout is sent to an administrator for approval"
msgstr "El diseño se envía a un administrador para su aprobación"

#: static/builder/builder.js
msgid "Saving the draft must succeed first."
msgstr "Primero debe completarse correctamente el guardado del borrador."

#: static/builder/builder.js
msgid "Publish layout"
msgstr "Publicar diseño"

#: static/builder/builder.js
msgid ""
"The current draft replaces the page content on the site. (The page’s own "
"status — published or draft — is controlled in the “Pages” section.)"
msgstr ""
"El borrador actual reemplaza el contenido de la página en el sitio. (El "
"estado propio de la página — publicada o borrador — se controla en la "
"sección «Páginas».)"

#: static/builder/builder.js
msgid "The layout was published."
msgstr "Se publicó el diseño."

#: static/builder/builder.js
msgid ""
"It will be published on the site after an administrator approves it. Until "
"then the current page is shown."
msgstr ""
"Se publicará en el sitio cuando un administrador lo apruebe. Hasta entonces "
"se muestra la página actual."

#: static/builder/builder.js
msgid "Submitted for approval."
msgstr "Enviado para su aprobación."

#: static/builder/builder.js
msgid "The version was saved."
msgstr "Se guardó la versión."

#: static/builder/builder.js
msgid "Unpublish the layout? The page goes back to its previous text content."
msgstr ""
"¿Despublicar el diseño? La página vuelve a su contenido de texto anterior."

#: static/builder/builder.js
msgid "The layout was unpublished."
msgstr "Se despublicó el diseño."

#: static/builder/builder.js
msgid "No version has been saved yet."
msgstr "Aún no se ha guardado ninguna versión."

#: static/builder/builder.js
msgid "Published"
msgstr "Publicada"

#: static/builder/builder.js
msgid "Automatic"
msgstr "Automática"

#: static/builder/builder.js
msgid "Version %(n)s"
msgstr "Versión %(n)s"

#: static/builder/builder.js
msgid " (reviewer: %(note)s)"
msgstr " (revisor: %(note)s)"

#: static/builder/builder.js
msgid "Preview"
msgstr "Vista previa"

#: static/builder/builder.js
msgid "Restore"
msgstr "Restaurar"

#: static/builder/builder.js
msgid ""
"Replace the current draft with version %(n)s? An automatic version of the "
"current state will be saved."
msgstr ""
"¿Reemplazar el borrador actual por la versión %(n)s? Se guardará una versión"
" automática del estado actual."

#: static/builder/builder.js
msgid "Version %(n)s was restored to the draft."
msgstr "La versión %(n)s se restauró en el borrador."

#: static/builder/builder.js
msgid "Approve and publish"
msgstr "Aprobar y publicar"

#: static/builder/builder.js
msgid "Approved and published."
msgstr "Aprobado y publicado."

#: static/builder/builder.js
msgid "Reject"
msgstr "Rechazar"

#: static/builder/builder.js
msgid "Reason for rejection (optional):"
msgstr "Motivo del rechazo (opcional):"

#: static/builder/builder.js
msgid "The version was rejected."
msgstr "Se rechazó la versión."

