msgid "No image selected — select this element and choose an image"
msgstr ""
"No hay ninguna imagen seleccionada — selecciona este elemento y elige una "
"imagen"

#: static/builder/builder.js
msgid "(button)"
msgstr "(botón)"

#: static/builder/builder.js
msgid "Drag an element from the side panel and drop it here"
msgstr "Arrastra un elemento desde el panel lateral y suéltalo aquí"

#: static/builder/builder.js
msgid "Drag a row from the side panel and drop it here"
msgstr "Arrastra una fila desde el panel lateral y suéltala aquí"

#: static/builder/builder.js
msgid "The page is empty."
msgstr "La página está vacía."

#: static/builder/builder.js
msgid "Drag a “Section” from the side panel and drop it here, or click it."
msgstr ""
"Arrastra una «Sección» desde el panel lateral y suéltala aquí, o haz clic en"
" ella."

#: static/builder/builder.js
msgid "You have reached the limit for the number of %(what)s in this section."
msgstr "Has alcanzado el límite de %(what)s en esta sección."

#: static/builder/builder.js
msgid "element"
msgstr "elementos"

#: static/builder/builder.js
msgid "The page has become too large."
msgstr "La página se ha vuelto demasiado grande."

#: static/builder/builder.js
msgid "First select a section."
msgstr "Primero selecciona una sección."

#: static/builder/builder.js
msgid "First select a column."
msgstr "Primero selecciona una columna."

#: static/builder/builder.js
msgid "First select a column (or an element inside a column)."
msgstr "Primero selecciona una columna (o un elemento dentro de una columna)."

#: static/builder/builder.js
msgid "You have reached the limit."
msgstr "Has alcanzado el límite."

#: static/builder/builder.js
msgid "To add a column use the row settings."
msgstr "Para añadir una columna usa los ajustes de la fila."

#: static/builder/builder.js
msgid "A row must have at least one column; delete the row itself."
msgstr "Una fila debe tener al menos una columna; elimina la propia fila."

