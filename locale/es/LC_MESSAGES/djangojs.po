msgid "/about/  or  https://…"
msgstr "/about/  o  https://…"

#: static/builder/builder.js
msgid ""
"The address is not allowed; use an internal path (/…), http(s), mailto or "
"tel."
msgstr ""
"La dirección no está permitida; usa una ruta interna (/…), http(s), mailto o"
" tel."

#: static/builder/builder.js
msgid "Page settings"
msgstr "Ajustes de la página"

#: static/builder/builder.js
msgid "To edit, click a section, row, column or element on the canvas."
msgstr ""
"Para editar, haz clic en una sección, fila, columna o elemento del lienzo."

