msgstr "Caducada"

msgid "Accepted"
msgstr "Aceptada"

msgid "Invited by"
msgstr "Invitado por"

msgid "Send invitation"
msgstr "Enviar invitación"

msgid "Invite someone by email. They choose a name and a password and their address counts as verified."
msgstr "Invite a alguien por correo. Elige su nombre y contraseña y su dirección cuenta como verificada."

msgid "Sent"
msgstr "Enviada"

