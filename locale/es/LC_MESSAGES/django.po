#, python-format
msgid "Theme ZIP install — %(kind)s: %(text)s"
msgstr "Instalación de tema desde ZIP — %(kind)s: %(text)s"

#: apps/themes/installer.py
msgid ""
"Installing themes from the web is turned off on this server. The server "
"administrator must deliberately set RAVIX_THEME_WEB_INSTALL=true (guide: "
"docs/themes.md)."
msgstr ""
"La instalación de temas desde la web está desactivada en este servidor. El "
"administrador del servidor debe definir deliberadamente "
"RAVIX_THEME_WEB_INSTALL=true (guía: docs/themes.md)."

#: apps/themes/installer.py
msgid "Only the superadmin may install themes."
msgstr "Solo el superadministrador puede instalar temas."

#: apps/themes/installer.py
msgid ""
"The theme install folder could not be created or is not writable; check "
"RAVIX_THEME_INSTALL_DIR and its permissions."
msgstr ""
"No se pudo crear la carpeta de instalación de temas o no es escribible; "
"revisa RAVIX_THEME_INSTALL_DIR y sus permisos."

#: apps/themes/installer.py
msgid ""
"The theme install folder is not writable; check RAVIX_THEME_INSTALL_DIR and "
"its permissions."
msgstr ""
"La carpeta de instalación de temas no es escribible; revisa "
"RAVIX_THEME_INSTALL_DIR y sus permisos."

#: apps/themes/installer.py
#, python-format
msgid ""
"The install folder’s file system (%(fstype)s) has no reliable locking; the "
"install was not performed to avoid conflicts. Put the install folder on a "
"local disk."
msgstr ""
"El sistema de archivos de la carpeta de instalación (%(fstype)s) no tiene un"
" bloqueo fiable; no se realizó la instalación para evitar conflictos. Pon la"
" carpeta de instalación en un disco local."

#: apps/themes/installer.py
msgid ""
"The install lock file could not be created; check the install folder "
"permissions."
msgstr ""
"No se pudo crear el archivo de bloqueo de instalación; revisa los permisos "
"de la carpeta de instalación."

#: apps/themes/installer.py
msgid "Another install is in progress right now; try again shortly."
msgstr ""
"Hay otra instalación en curso ahora mismo; inténtalo de nuevo en breve."

#: apps/themes/installer.py
msgid ""
"File-system locking is not supported on the install folder; the install was "
"not performed for safety. Put the install folder on a local disk."
msgstr ""
"El bloqueo del sistema de archivos no es compatible con la carpeta de "
"instalación; no se realizó la instalación por seguridad. Pon la carpeta de "
"instalación en un disco local."

#: apps/themes/installer.py
msgid ""
"The default theme (“default”) cannot be replaced or overwritten this way."
msgstr ""
"El tema predeterminado («default») no se puede reemplazar ni sobrescribir de"
" esta forma."

#: apps/themes/installer.py
#, python-format
msgid ""
"A theme with the ID “%(slug)s” already exists and will not be overwritten. "
"Change the theme ID in theme.json and the folder name."
msgstr ""
"Ya existe un tema con el ID «%(slug)s» y no se sobrescribirá. Cambia el ID "
"del tema en theme.json y el nombre de la carpeta."

#: apps/themes/installer.py
msgid ""
"The temporary folder was created in an invalid place; the install was "
"cancelled."
msgstr ""
"La carpeta temporal se creó en un lugar no válido; se canceló la "
"instalación."

#: apps/themes/installer.py
msgid "The theme is not compatible with the Ravix theme contract."
msgstr "El tema no es compatible con el contrato de temas de Ravix."

#: apps/themes/installer.py
msgid "The destination path is invalid; the install was cancelled."
msgstr "La ruta de destino no es válida; se canceló la instalación."

#: apps/themes/installer.py
msgid "The final placement of the theme failed and no changes were applied."
msgstr "Falló la colocación final del tema y no se aplicó ningún cambio."

#: apps/themes/installer.py
msgid "The final validation after install failed; the install was cancelled."
msgstr ""
"Falló la validación final tras la instalación; se canceló la instalación."

#: apps/themes/installer.py
msgid "Start"
msgstr "Inicio"

#: apps/themes/installer.py
#, python-format
msgid "Request received (size %(value)s KB)."
msgstr "Solicitud recibida (tamaño %(value)s KB)."

#: apps/themes/installer.py apps/themes/package.py
msgid "No file was sent or the file is empty."
msgstr "No se envió ningún archivo o el archivo está vacío."

#: apps/themes/installer.py apps/themes/package.py
#, python-format
msgid "The file is larger than %(value)s MB."
msgstr "El archivo pesa más de %(value)s MB."

#: apps/themes/installer.py
msgid "Security rejection"
msgstr "Rechazo por seguridad"

#: apps/themes/installer.py apps/themes/views.py
msgid "Was rejected"
msgstr "Fue rechazado"

#: apps/themes/installer.py
msgid "Internal error"
msgstr "Error interno"

#: apps/themes/installer.py
msgid ""
"The install stopped with an unexpected error; the details are only in the "
"server log and no changes were applied."
msgstr ""
"La instalación se detuvo por un error inesperado; los detalles solo están en"
" el registro del servidor y no se aplicó ningún cambio."

#: apps/themes/installer.py
msgid ""
"An unexpected error occurred and no changes were applied; the server "
"administrator can see the details in the logs."
msgstr ""
"Se produjo un error inesperado y no se aplicó ningún cambio; el "
"administrador del servidor puede ver los detalles en los registros."

#: apps/themes/installer.py
#, python-format
msgid ""
"Theme “%(slug)s” version %(value)s was installed (%(file_count)s files); it "
"was not activated."
msgstr ""
"Se instaló el tema «%(slug)s» versión %(value)s (%(file_count)s archivos); "
"no se activó."

#: apps/themes/manifest.py
#, python-format
msgid "The field “%(key)s” is required in theme.json."
msgstr "El campo «%(key)s» es obligatorio en theme.json."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The field “%(key)s” must be a string of at most %(max_len)s characters."
msgstr ""
"El campo «%(key)s» debe ser una cadena de %(max_len)s caracteres como "
"máximo."

#: apps/themes/manifest.py
#, python-format
msgid "File or folder not allowed in the theme root: “%(name)s”."
msgstr "Archivo o carpeta no permitido en la raíz del tema: «%(name)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(relative_to)s”."
msgstr "No se permiten enlaces simbólicos: «%(relative_to)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(rel)s”."
msgstr "No se permiten enlaces simbólicos: «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The file type of “%(rel)s” is not allowed in a theme (only files that cannot"
" run on the server)."
msgstr ""
"El tipo de archivo de «%(rel)s» no se permite en un tema (solo archivos que "
"no se puedan ejecutar en el servidor)."

#: apps/themes/manifest.py
#, python-format
msgid "The templates folder accepts only html files: “%(rel)s”."
msgstr "La carpeta de plantillas solo acepta archivos html: «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The locale folder accepts only <language>.json files for the supported "
"languages (for example fr.json or pt-br.json): “%(rel)s”."
msgstr ""
"La carpeta locale solo acepta archivos <language>.json de los idiomas "
"admitidos (por ejemplo fr.json o pt-br.json): «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The translation file “%(rel)s” must be a JSON object that maps English text "
"to its translation (text only, within the size limits)."
msgstr ""
"El archivo de traducción «%(rel)s» debe ser un objeto JSON que asocie el "
"texto en inglés con su traducción (solo texto, dentro de los límites de "
"tamaño)."

#: apps/themes/manifest.py
#, python-format
msgid ""
"html files are not allowed in the static folder: “%(rel)s” (html templates "
"must be in templates)."
msgstr ""
"No se permiten archivos html en la carpeta static: «%(rel)s» (las plantillas"
" html deben estar en templates)."

#: apps/themes/manifest.py
#, python-format
msgid "The size of file “%(rel)s” exceeds the limit."
msgstr "El tamaño del archivo «%(rel)s» supera el límite."

#: apps/themes/manifest.py apps/themes/package.py
#, python-format
msgid "The number of theme files exceeds %(MAX_FILES)s."
msgstr "El número de archivos del tema supera %(MAX_FILES)s."

#: apps/themes/manifest.py
#, python-format
msgid "The required template “%(name)s” does not exist."
msgstr "La plantilla obligatoria «%(name)s» no existe."

#: apps/themes/manifest.py
#, python-format
msgid "The file “%(rel)s” must be valid UTF-8 text."
msgstr "El archivo «%(rel)s» debe ser texto UTF-8 válido."

#: apps/themes/manifest.py
#, python-format
msgid ""
"Loading the library “%(lib)s” in “%(rel)s” is not allowed (only ravix_theme "
"and i18n)."
msgstr ""
"No se permite cargar la biblioteca «%(lib)s» en «%(rel)s» (solo ravix_theme "
"e i18n)."

#: apps/themes/manifest.py
#, python-format
msgid "The {%% debug %%} tag is not allowed in “%(rel)s”."
msgstr "La etiqueta {%% debug %%} no se permite en «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Syntax error in “%(rel)s”: %(exc)s"
msgstr "Error de sintaxis en «%(rel)s»: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid "base.html must use the {%% %(tag)s %%} tag."
msgstr "base.html debe usar la etiqueta {%% %(tag)s %%}."

#: apps/themes/manifest.py
msgid ""
"The theme folder name may only contain lowercase English letters, digits, "
"“-” and “_”."
msgstr ""
"El nombre de la carpeta del tema solo puede contener letras inglesas "
"minúsculas, dígitos, «-» y «_»."

#: apps/themes/manifest.py
msgid "The theme folder cannot be a symbolic link."
msgstr "La carpeta del tema no puede ser un enlace simbólico."

#: apps/themes/manifest.py
msgid "The theme.json file was not found."
msgstr "No se encontró el archivo theme.json."

#: apps/themes/manifest.py
msgid "theme.json cannot be a symbolic link."
msgstr "theme.json no puede ser un enlace simbólico."

#: apps/themes/manifest.py
msgid "The size of theme.json exceeds the limit."
msgstr "El tamaño de theme.json supera el límite."

#: apps/themes/manifest.py
msgid "theme.json must be a JSON object."
msgstr "theme.json debe ser un objeto JSON."

#: apps/themes/manifest.py
#, python-format
msgid "theme.json is not valid: %(exc)s"
msgstr "theme.json no es válido: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid ""
"api_version must be %(API_VERSION)s (the theme was built for another version"
" of the contract)."
msgstr ""
"api_version debe ser %(API_VERSION)s (el tema se creó para otra versión del "
"contrato)."

#: apps/themes/manifest.py
msgid ""
"The “slug” value in theme.json must match the theme folder name exactly."
msgstr ""
"El valor «slug» de theme.json debe coincidir exactamente con el nombre de la"
" carpeta del tema."

#: apps/themes/manifest.py
msgid "“version” must be in semantic versioning form (e.g. 1.0.0)."
msgstr "«version» debe tener forma de versionado semántico (p. ej. 1.0.0)."

#: apps/themes/manifest.py
msgid "“ravix” must be a version range (e.g. >=0.6,<1.0)."
msgstr "«ravix» debe ser un rango de versiones (p. ej. >=0.6,<1.0)."

#: apps/themes/manifest.py
msgid ""
"The “screenshot” path is invalid (it must be a png/jpg/webp file inside "
"static)."
msgstr ""
"La ruta de «screenshot» no es válida (debe ser un archivo png/jpg/webp "
"dentro de static)."

#: apps/themes/manifest.py
msgid "The templates folder does not exist."
msgstr "La carpeta de plantillas no existe."

#: apps/themes/manifest.py
msgid "The theme folder does not exist."
msgstr "La carpeta del tema no existe."

#: apps/themes/models.py
msgid "Active theme"
msgstr "Tema activo"

#: apps/themes/models.py
msgid "Published configuration"
msgstr "Configuración publicada"

#: apps/themes/models.py
msgid "Draft changes"
msgstr "Cambios del borrador"

#: apps/themes/models.py
msgid "Last draft edit"
msgstr "Última edición del borrador"

#: apps/themes/models.py
msgid "Last publish time"
msgstr "Última hora de publicación"

#: apps/themes/models.py
msgid "Published by"
msgstr "Publicado por"

#: apps/themes/models.py
msgid "Site appearance settings"
msgstr "Ajustes de apariencia del sitio"

#: apps/themes/models.py
#, python-format
msgid "Active theme: %(active_theme)s"
msgstr "Tema activo: %(active_theme)s"

#: apps/themes/package.py
msgid "This file is not a valid ZIP (the file signature does not match ZIP)."
msgstr ""
"Este archivo no es un ZIP válido (la firma del archivo no coincide con ZIP)."

#: apps/themes/package.py
msgid "The ZIP file is corrupted or incomplete and could not be opened."
msgstr "El archivo ZIP está dañado o incompleto y no se pudo abrir."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "Nombre inseguro en el ZIP (barra invertida): «%(show)s»."

#: apps/themes/package.py
msgid "Unsafe name in ZIP (control character)."
msgstr "Nombre inseguro en el ZIP (carácter de control)."

#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "No se permiten rutas absolutas en el ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr "Ruta insegura en el ZIP (. o .. o un segmento vacío): «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "La ruta «%(show)s» es demasiado larga o profunda."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters,"
" no leading dot)."
msgstr ""
"El nombre «%(show)s» no está permitido; los nombres de archivos y carpetas "
"solo pueden contener letras inglesas, dígitos, «.», «-» y «_» (sin espacios,"
" sin caracteres persas, sin punto inicial)."

#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "No se permite un archivo sin extensión: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"No se permite un archivo ejecutable o script en un tema (como py o php): "
"«%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"SVG files are not allowed in this version: “%(show)s”. Use png, webp or jpg "
"instead."
msgstr ""
"No se permiten archivos SVG en esta versión: «%(show)s». Usa png, webp o jpg"
" en su lugar."

#: apps/themes/package.py
#, python-format
msgid "The file extension of “%(show)s” is not allowed in a theme."
msgstr "La extensión de «%(show)s» no está permitida en un tema."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "El ZIP está vacío."

#: apps/themes/package.py
#, python-format
msgid ""
"The number of ZIP entries exceeds the limit (at most %(MAX_ZIP_ENTRIES)s)."
msgstr ""
"El número de entradas del ZIP supera el límite (como máximo "
"%(MAX_ZIP_ENTRIES)s)."

#: apps/themes/package.py
#, python-format
msgid "Symbolic links are not allowed in ZIP: “%(show)s”."
msgstr "No se permiten enlaces simbólicos en el ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Special or unusual entries are not allowed in ZIP: “%(show)s”."
msgstr "No se permiten entradas especiales o inusuales en el ZIP: «%(show)s»."

#: apps/themes/package.py
msgid "Encrypted ZIP files are not allowed."
msgstr "No se permiten archivos ZIP cifrados."

#: apps/themes/package.py
msgid ""
"The ZIP compression method is not supported (only Deflate or no "
"compression)."
msgstr ""
"El método de compresión del ZIP no es compatible (solo Deflate o sin "
"compresión)."

#: apps/themes/package.py
#, python-format
msgid "Inconsistent entry in ZIP: “%(show)s”."
msgstr "Entrada incoherente en el ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Duplicate name (or differing only in letter case) in ZIP: “%(show)s”."
msgstr ""
"Nombre duplicado (o que solo difiere en mayúsculas/minúsculas) en el ZIP: "
"«%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"El archivo «%(show)s» está fuera de la carpeta del tema. Todos los archivos "
"deben estar dentro de una carpeta con el ID del tema (p. ej. my-"
"theme/theme.json)."

#: apps/themes/package.py
#, python-format
msgid "The size of file “%(show)s” exceeds %(value)s MB."
msgstr "El tamaño del archivo «%(show)s» supera %(value)s MB."

#: apps/themes/package.py
msgid "The ZIP is suspicious (a zero-size file in the compressed data)."
msgstr ""
"El ZIP es sospechoso (un archivo de tamaño cero en los datos comprimidos)."

#: apps/themes/package.py
#, python-format
msgid "The compression ratio of “%(show)s” is unusual (possible zip bomb)."
msgstr ""
"La relación de compresión de «%(show)s» es inusual (posible bomba zip)."

#: apps/themes/package.py
#, python-format
msgid "The total size of the extracted files exceeds %(value)s MB."
msgstr "El tamaño total de los archivos extraídos supera %(value)s MB."

#: apps/themes/package.py
msgid ""
"The ZIP must have only one root folder (named after the theme ID). If you "
"made the ZIP on macOS, do not include the __MACOSX folder; put the files "
"inside one folder and zip again."
msgstr ""
"El ZIP debe tener una sola carpeta raíz (con el ID del tema). Si creaste el "
"ZIP en macOS, no incluyas la carpeta __MACOSX; pon los archivos dentro de "
"una carpeta y comprime de nuevo."

#: apps/themes/package.py
#, python-format
msgid ""
"The root folder name (“%(show)s”) is not a valid theme ID; only lowercase "
"English letters, digits, “-” and “_” (at most 49 characters)."
msgstr ""
"El nombre de la carpeta raíz («%(show)s») no es un ID de tema válido; solo "
"letras inglesas minúsculas, dígitos, «-» y «_» (como máximo 49 caracteres)."

#: apps/themes/package.py
msgid "Conflicting paths in ZIP (one name is both a file and a folder)."
msgstr ""
"Rutas en conflicto en el ZIP (un nombre es a la vez archivo y carpeta)."

#: apps/themes/package.py
msgid "The ZIP contains no files."
msgstr "El ZIP no contiene archivos."

#: apps/themes/package.py
msgid "Path outside the destination folder in ZIP (zip-slip)."
msgstr "Ruta fuera de la carpeta de destino en el ZIP (zip-slip)."

#: apps/themes/package.py
msgid ""
"The real size of the extracted files exceeds the limit (possible zip bomb)."
msgstr ""
"El tamaño real de los archivos extraídos supera el límite (posible bomba "
"zip)."

#: apps/themes/package.py
msgid ""
"The real size of one of the files does not match the ZIP declaration; the "
"ZIP is tampered with or corrupted."
msgstr ""
"El tamaño real de uno de los archivos no coincide con lo declarado en el "
"ZIP; el ZIP está manipulado o dañado."

#: apps/themes/package.py
msgid "The ZIP file is corrupted (the compressed content is not valid)."
msgstr "El archivo ZIP está dañado (el contenido comprimido no es válido)."

#: apps/themes/package.py
msgid "Duplicate name in ZIP."
msgstr "Nombre duplicado en el ZIP."

#: apps/themes/package.py
msgid ""
"Could not write to the temporary folder; check the server’s permissions and "
"disk space."
msgstr ""
"No se pudo escribir en la carpeta temporal; revisa los permisos del servidor"
" y el espacio en disco."

#: apps/themes/services.py
msgid "This theme was not found. Its folder must exist in the themes path."
msgstr ""
"No se encontró este tema. Su carpeta debe existir en la ruta de temas."

#: apps/themes/services.py
#, python-format
msgid "This theme is invalid and cannot be used: %(items)s"
msgstr "Este tema no es válido y no se puede usar: %(items)s"

#: apps/themes/services.py
msgid "Invalid section."
msgstr "Sección no válida."

#: apps/themes/services.py
msgid "Appearance"
msgstr "Apariencia"

#: apps/themes/services.py templates/themes/customize_layout.html
msgid "Header"
msgstr "Cabecera"

#: apps/themes/services.py templates/themes/customize_layout.html
msgid "Footer"
msgstr "Pie de página"

#: apps/themes/services.py templates/themes/_status.html
msgid "Menus"
msgstr "Menús"

#: apps/themes/services.py
#, python-format
msgid "The site appearance draft was saved (section %(labels)s)."
msgstr ""
"Se guardó el borrador de la apariencia del sitio (sección %(labels)s)."

#: apps/themes/services.py
#, python-format
msgid "Preview of theme “%(display_name)s” started."
msgstr "Se inició la vista previa del tema «%(display_name)s»."

#: apps/themes/services.py
msgid "There is no draft to discard."
msgstr "No hay ningún borrador que descartar."

#: apps/themes/services.py
msgid "The site appearance draft changes were discarded."
msgstr "Se descartaron los cambios del borrador de la apariencia del sitio."

#: apps/themes/services.py
msgid "There are no unpublished changes."
msgstr "No hay cambios sin publicar."

#: apps/themes/services.py
msgid ""
"The draft colors are not valid or readable; first fix the “Appearance” "
"section."
msgstr ""
"Los colores del borrador no son válidos o legibles; primero corrige la "
"sección «Apariencia»."

#: apps/themes/services.py
#, python-format
msgid "The site appearance changes were published (theme “%(display_name)s”)."
