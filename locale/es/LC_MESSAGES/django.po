msgstr "Las personas deben abrir el enlace del correo de verificación antes de iniciar sesión. Requiere correo funcionando (envíe primero uno de prueba)."

msgid "Without “Remember me”, the sign-in ends when the browser is closed."
msgstr "Sin «Recordarme», el inicio de sesión termina al cerrar el navegador."

msgid "Sign-in requires a verified email"
msgstr "Iniciar sesión requiere un correo verificado"

msgid "New accounts must accept the terms"
msgstr "Las cuentas nuevas deben aceptar los términos"

msgid "Privacy policy page"
msgstr "Página de la política de privacidad"

msgid "An invitation is valid for (days)"
msgstr "Una invitación es válida durante (días)"

msgid "Administrators may invite people"
msgstr "Los administradores pueden invitar a personas"

msgid "Terms of use page"
msgstr "Página de los términos de uso"

msgid "“Remember me” lasts (days)"
msgstr "«Recordarme» dura (días)"

