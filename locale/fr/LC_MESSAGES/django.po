#, python-format
msgid ""
"A theme with the ID “%(slug)s” already exists and will not be overwritten. "
"Change the theme ID in theme.json and the folder name."
msgstr ""
"Un thème avec l’ID « %(slug)s » existe déjà et ne sera pas écrasé. Changez "
"l’ID du thème dans theme.json et le nom du dossier."

