msgid ""
"The “slug” value in theme.json must match the theme folder name exactly."
msgstr ""
"La valeur « slug » de theme.json doit correspondre exactement au nom du "
"dossier du thème."

#: apps/themes/manifest.py
msgid "“version” must be in semantic versioning form (e.g. 1.0.0)."
msgstr ""
"« version » doit être au format de versionnage sémantique (p. ex. 1.0.0)."

#: apps/themes/manifest.py
msgid "“ravix” must be a version range (e.g. >=0.6,<1.0)."
msgstr "« ravix » doit être une plage de versions (p. ex. >=0.6,<1.0)."

#: apps/themes/manifest.py
msgid ""
"The “screenshot” path is invalid (it must be a png/jpg/webp file inside "
"static)."
msgstr ""
"Le chemin de « screenshot » n’est pas valide (ce doit être un fichier png/"
"jpg/webp dans static)."

#: apps/themes/manifest.py
msgid "The templates folder does not exist."
msgstr "Le dossier des modèles n’existe pas."

#: apps/themes/manifest.py
msgid "The theme folder does not exist."
msgstr "Le dossier du thème n’existe pas."

