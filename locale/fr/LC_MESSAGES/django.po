msgstr "Thème actif : %(active_theme)s"

#: apps/themes/package.py
msgid "This file is not a valid ZIP (the file signature does not match ZIP)."
msgstr ""
"Ce fichier n’est pas un ZIP valide (la signature du fichier ne correspond "
"pas à un ZIP)."

#: apps/themes/package.py
msgid "The ZIP file is corrupted or incomplete and could not be opened."
msgstr "Le fichier ZIP est corrompu ou incomplet et n’a pas pu être ouvert."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "Nom dangereux dans le ZIP (barre oblique inverse) : « %(show)s »."

#: apps/themes/package.py
msgid "Unsafe name in ZIP (control character)."
msgstr "Nom dangereux dans le ZIP (caractère de contrôle)."

#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "Les chemins absolus ne sont pas autorisés dans le ZIP : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr "Chemin dangereux dans le ZIP (. ou .. ou segment vide) : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "Le chemin « %(show)s » est trop long ou trop profond."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters, "
"no leading dot)."
msgstr ""
"Le nom « %(show)s » n’est pas autorisé ; les noms de fichiers et de dossiers "
"ne peuvent contenir que des lettres anglaises, des chiffres, « . », « - » et "
"« _ » (pas d’espaces, pas de caractères persans, pas de point initial)."

#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "Un fichier sans extension n’est pas autorisé : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"Un fichier exécutable ou script n’est pas autorisé dans un thème (comme py "
"ou php) : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid ""
"SVG files are not allowed in this version: “%(show)s”. Use png, webp or jpg "
"instead."
msgstr ""
"Les fichiers SVG ne sont pas autorisés dans cette version : « %(show)s ». "
"Utilisez plutôt png, webp ou jpg."

#: apps/themes/package.py
#, python-format
msgid "The file extension of “%(show)s” is not allowed in a theme."
msgstr ""
"L’extension de fichier de « %(show)s » n’est pas autorisée dans un thème."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "Le ZIP est vide."

#: apps/themes/package.py
#, python-format
msgid ""
"The number of ZIP entries exceeds the limit (at most %(MAX_ZIP_ENTRIES)s)."
msgstr ""
"Le nombre d’entrées du ZIP dépasse la limite (au plus %(MAX_ZIP_ENTRIES)s)."

#: apps/themes/package.py
#, python-format
msgid "Symbolic links are not allowed in ZIP: “%(show)s”."
msgstr ""
"Les liens symboliques ne sont pas autorisés dans le ZIP : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid "Special or unusual entries are not allowed in ZIP: “%(show)s”."
msgstr ""
"Les entrées spéciales ou inhabituelles ne sont pas autorisées dans le ZIP : "
"« %(show)s »."

#: apps/themes/package.py
msgid "Encrypted ZIP files are not allowed."
msgstr "Les fichiers ZIP chiffrés ne sont pas autorisés."

#: apps/themes/package.py
msgid ""
"The ZIP compression method is not supported (only Deflate or no compression)."
msgstr ""
"La méthode de compression du ZIP n’est pas prise en charge (Deflate ou "
"aucune compression uniquement)."

#: apps/themes/package.py
#, python-format
msgid "Inconsistent entry in ZIP: “%(show)s”."
msgstr "Entrée incohérente dans le ZIP : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid "Duplicate name (or differing only in letter case) in ZIP: “%(show)s”."
msgstr ""
"Nom en double (ou ne différant que par la casse) dans le ZIP : « %(show)s »."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"Le fichier « %(show)s » est en dehors du dossier du thème. Tous les fichiers "
"doivent se trouver dans un seul dossier nommé d’après l’ID du thème (p. ex. "
"my-theme/theme.json)."

#: apps/themes/package.py
#, python-format
msgid "The size of file “%(show)s” exceeds %(value)s MB."
msgstr "La taille du fichier « %(show)s » dépasse %(value)s Mo."

#: apps/themes/package.py
msgid "The ZIP is suspicious (a zero-size file in the compressed data)."
msgstr ""
"Le ZIP est suspect (un fichier de taille nulle dans les données compressées)."

#: apps/themes/package.py
#, python-format
msgid "The compression ratio of “%(show)s” is unusual (possible zip bomb)."
msgstr ""
"Le taux de compression de « %(show)s » est inhabituel (bombe zip possible)."

#: apps/themes/package.py
#, python-format
msgid "The total size of the extracted files exceeds %(value)s MB."
msgstr "La taille totale des fichiers extraits dépasse %(value)s Mo."

#: apps/themes/package.py
msgid ""
"The ZIP must have only one root folder (named after the theme ID). If you "
"made the ZIP on macOS, do not include the __MACOSX folder; put the files "
"inside one folder and zip again."
msgstr ""
"Le ZIP ne doit avoir qu’un seul dossier racine (nommé d’après l’ID du "
"thème). Si vous avez créé le ZIP sous macOS, n’incluez pas le dossier "
"__MACOSX ; placez les fichiers dans un seul dossier et recompressez."

#: apps/themes/package.py
#, python-format
msgid ""
"The root folder name (“%(show)s”) is not a valid theme ID; only lowercase "
"English letters, digits, “-” and “_” (at most 49 characters)."
msgstr ""
"Le nom du dossier racine (« %(show)s ») n’est pas un ID de thème valide ; "
"uniquement des lettres anglaises minuscules, des chiffres, « - » et « _ "
"» (49 caractères au maximum)."

#: apps/themes/package.py
msgid "Conflicting paths in ZIP (one name is both a file and a folder)."
msgstr ""
"Chemins en conflit dans le ZIP (un nom est à la fois un fichier et un "
"dossier)."

#: apps/themes/package.py
msgid "The ZIP contains no files."
msgstr "Le ZIP ne contient aucun fichier."

#: apps/themes/package.py
msgid "Path outside the destination folder in ZIP (zip-slip)."
msgstr "Chemin en dehors du dossier de destination dans le ZIP (zip-slip)."

#: apps/themes/package.py
msgid ""
"The real size of the extracted files exceeds the limit (possible zip bomb)."
msgstr ""
"La taille réelle des fichiers extraits dépasse la limite (bombe zip "
"possible)."

#: apps/themes/package.py
msgid ""
"The real size of one of the files does not match the ZIP declaration; the "
"ZIP is tampered with or corrupted."
msgstr ""
"La taille réelle de l’un des fichiers ne correspond pas à la déclaration du "
"ZIP ; le ZIP est falsifié ou corrompu."

#: apps/themes/package.py
msgid "The ZIP file is corrupted (the compressed content is not valid)."
msgstr "Le fichier ZIP est corrompu (le contenu compressé n’est pas valide)."

#: apps/themes/package.py
msgid "Duplicate name in ZIP."
msgstr "Nom en double dans le ZIP."

#: apps/themes/package.py
msgid ""
"Could not write to the temporary folder; check the server’s permissions and "
"disk space."
msgstr ""
"Impossible d’écrire dans le dossier temporaire ; vérifiez les permissions du "
"serveur et l’espace disque."

