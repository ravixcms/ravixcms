msgstr ""
"Le chargement de la bibliothèque « %(lib)s » dans « %(rel)s » n’est pas "
"autorisé (uniquement ravix_theme et i18n)."

#: apps/themes/manifest.py
#, python-format
msgid "The {%% debug %%} tag is not allowed in “%(rel)s”."
msgstr "La balise {%% debug %%} n’est pas autorisée dans « %(rel)s »."

#: apps/themes/manifest.py
#, python-format
msgid "Syntax error in “%(rel)s”: %(exc)s"
msgstr "Erreur de syntaxe dans « %(rel)s » : %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid "base.html must use the {%% %(tag)s %%} tag."
msgstr "base.html doit utiliser la balise {%% %(tag)s %%}."

#: apps/themes/manifest.py
msgid ""
"The theme folder name may only contain lowercase English letters, digits, "
"“-” and “_”."
msgstr ""
"Le nom du dossier du thème ne peut contenir que des lettres anglaises "
"minuscules, des chiffres, « - » et « _ »."

#: apps/themes/manifest.py
msgid "The theme folder cannot be a symbolic link."
msgstr "Le dossier du thème ne peut pas être un lien symbolique."

#: apps/themes/manifest.py
msgid "The theme.json file was not found."
msgstr "Le fichier theme.json est introuvable."

#: apps/themes/manifest.py
msgid "theme.json cannot be a symbolic link."
msgstr "theme.json ne peut pas être un lien symbolique."

#: apps/themes/manifest.py
msgid "The size of theme.json exceeds the limit."
msgstr "La taille de theme.json dépasse la limite."

#: apps/themes/manifest.py
msgid "theme.json must be a JSON object."
msgstr "theme.json doit être un objet JSON."

#: apps/themes/manifest.py
#, python-format
msgid "theme.json is not valid: %(exc)s"
msgstr "theme.json n’est pas valide : %(exc)s"

