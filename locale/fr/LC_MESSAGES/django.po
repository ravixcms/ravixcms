msgstr ""
"Le champ « %(key)s » doit être une chaîne de %(max_len)s caractères au "
"maximum."

#: apps/themes/manifest.py
#, python-format
msgid "File or folder not allowed in the theme root: “%(name)s”."
msgstr "Fichier ou dossier non autorisé à la racine du thème : « %(name)s »."

