#, python-format
msgid ""
"html files are not allowed in the static folder: “%(rel)s” (html templates "
"must be in templates)."
msgstr ""
"Les fichiers html ne sont pas autorisés dans le dossier static : « %(rel)s "
"» (les modèles html doivent être dans templates)."

