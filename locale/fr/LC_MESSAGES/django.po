msgstr "Les liens symboliques ne sont pas autorisés : « %(relative_to)s »."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(rel)s”."
msgstr "Les liens symboliques ne sont pas autorisés : « %(rel)s »."

