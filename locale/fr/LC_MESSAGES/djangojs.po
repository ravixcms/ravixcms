msgid "Drag to move"
msgstr "Faites glisser pour déplacer"

#: static/builder/builder.js
msgid "Move %(type)s"
msgstr "Déplacer : %(type)s"

#: static/builder/builder.js
msgid "Previous column"
msgstr "Colonne précédente"

#: static/builder/builder.js
msgid "Up"
msgstr "Haut"

#: static/builder/builder.js
msgid "Next column"
msgstr "Colonne suivante"

#: static/builder/builder.js
