msgstr "texte en gras"

#: static/js/ravix.js
msgid "italic text"
msgstr "texte en italique"

#: static/js/ravix.js
msgid "code"
msgstr "code"

#: static/js/ravix.js
msgid "link text"
msgstr "texte du lien"

#: static/js/ravix.js
msgid "image description"
msgstr "description de l’image"

#: static/js/ravix.js
msgid "Nothing to preview."
msgstr "Rien à prévisualiser."

#: static/js/ravix.js
msgid "Preview is not available."
msgstr "L’aperçu n’est pas disponible."

#: static/js/ravix.js
msgid "%(n)s of %(max)s characters"
msgstr "%(n)s sur %(max)s caractères"

#: static/js/ravix.js
