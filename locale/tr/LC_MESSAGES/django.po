msgstr ""
"Satır %(number)s: doğru biçim “Başlık | URL” (başlık en fazla 40 karakter)."

#: apps/themes/forms.py
#, python-format
msgid "Line %(number)s: %(messages)s"
msgstr "Satır %(number)s: %(messages)s"

#: apps/themes/forms.py
#, python-format
msgid "At most %(MAX_SOCIAL_LINKS)s links are allowed."
msgstr "En fazla %(MAX_SOCIAL_LINKS)s bağlantıya izin verilir."

#: apps/themes/forms.py
msgid "Fill in both the button text and URL, or leave both empty."
msgstr ""
"Düğme metnini ve URL’sini birlikte doldurun veya ikisini de boş bırakın."

