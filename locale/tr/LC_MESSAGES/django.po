#: apps/themes/installer.py
#, python-format
msgid "Theme ZIP install — %(kind)s: %(text)s"
msgstr "Tema ZIP kurulumu — %(kind)s: %(text)s"

#: apps/themes/installer.py
msgid ""
"Installing themes from the web is turned off on this server. The server "
"administrator must deliberately set RAVIX_THEME_WEB_INSTALL=true (guide: "
"docs/themes.md)."
msgstr ""
"Web üzerinden tema kurulumu bu sunucuda kapalı. Sunucu yöneticisi "
"RAVIX_THEME_WEB_INSTALL=true değerini bilerek ayarlamalıdır (kılavuz: "
"docs/themes.md)."

#: apps/themes/installer.py
msgid "Only the superadmin may install themes."
msgstr "Temaları yalnızca süper yönetici kurabilir."

#: apps/themes/installer.py
msgid ""
"The theme install folder could not be created or is not writable; check "
"RAVIX_THEME_INSTALL_DIR and its permissions."
msgstr ""
"Tema kurulum klasörü oluşturulamadı veya yazılabilir değil; "
"RAVIX_THEME_INSTALL_DIR ve izinlerini kontrol edin."

#: apps/themes/installer.py
msgid ""
"The theme install folder is not writable; check RAVIX_THEME_INSTALL_DIR and "
"its permissions."
msgstr ""
"Tema kurulum klasörü yazılabilir değil; RAVIX_THEME_INSTALL_DIR ve "
"izinlerini kontrol edin."

#: apps/themes/installer.py
#, python-format
msgid ""
"The install folder’s file system (%(fstype)s) has no reliable locking; the "
"install was not performed to avoid conflicts. Put the install folder on a "
"local disk."
msgstr ""
"Kurulum klasörünün dosya sisteminde (%(fstype)s) güvenilir kilitleme yok; "
"çakışmaları önlemek için kurulum yapılmadı. Kurulum klasörünü yerel bir "
"diske koyun."

#: apps/themes/installer.py
msgid ""
"The install lock file could not be created; check the install folder "
"permissions."
msgstr ""
"Kurulum kilit dosyası oluşturulamadı; kurulum klasörünün izinlerini kontrol "
"edin."

#: apps/themes/installer.py
msgid "Another install is in progress right now; try again shortly."
msgstr "Şu anda başka bir kurulum sürüyor; kısa süre sonra tekrar deneyin."

#: apps/themes/installer.py
msgid ""
"File-system locking is not supported on the install folder; the install was "
"not performed for safety. Put the install folder on a local disk."
msgstr ""
"Kurulum klasöründe dosya sistemi kilitlemesi desteklenmiyor; güvenlik için "
"kurulum yapılmadı. Kurulum klasörünü yerel bir diske koyun."

#: apps/themes/installer.py
msgid ""
"The default theme (“default”) cannot be replaced or overwritten this way."
msgstr ""
"Varsayılan tema (“default”) bu yolla değiştirilemez veya üzerine yazılamaz."

#: apps/themes/installer.py
#, python-format
msgid ""
"A theme with the ID “%(slug)s” already exists and will not be overwritten. "
"Change the theme ID in theme.json and the folder name."
msgstr ""
"“%(slug)s” kimlikli bir tema zaten var ve üzerine yazılmayacak. theme.json "
"içindeki tema kimliğini ve klasör adını değiştirin."

#: apps/themes/installer.py
msgid ""
"The temporary folder was created in an invalid place; the install was "
"cancelled."
msgstr "Geçici klasör geçersiz bir yerde oluşturuldu; kurulum iptal edildi."

#: apps/themes/installer.py
msgid "The theme is not compatible with the Ravix theme contract."
msgstr "Tema, Ravix tema sözleşmesiyle uyumlu değil."

#: apps/themes/installer.py
msgid "The destination path is invalid; the install was cancelled."
msgstr "Hedef yol geçersiz; kurulum iptal edildi."

#: apps/themes/installer.py
msgid "The final placement of the theme failed and no changes were applied."
msgstr ""
"Temanın son yerleştirmesi başarısız oldu ve hiçbir değişiklik uygulanmadı."

#: apps/themes/installer.py
msgid "The final validation after install failed; the install was cancelled."
msgstr "Kurulum sonrası son doğrulama başarısız oldu; kurulum iptal edildi."

#: apps/themes/installer.py
msgid "Start"
msgstr "Başlat"

#: apps/themes/installer.py
#, python-format
msgid "Request received (size %(value)s KB)."
msgstr "İstek alındı (boyut %(value)s KB)."

#: apps/themes/installer.py apps/themes/package.py
msgid "No file was sent or the file is empty."
msgstr "Hiçbir dosya gönderilmedi veya dosya boş."

#: apps/themes/installer.py apps/themes/package.py
#, python-format
msgid "The file is larger than %(value)s MB."
msgstr "Dosya %(value)s MB’tan büyük."

#: apps/themes/installer.py
msgid "Security rejection"
msgstr "Güvenlik reddi"

#: apps/themes/installer.py apps/themes/views.py
msgid "Was rejected"
msgstr "Reddedildi"

#: apps/themes/installer.py
msgid "Internal error"
msgstr "İç hata"

#: apps/themes/installer.py
msgid ""
"The install stopped with an unexpected error; the details are only in the "
"server log and no changes were applied."
msgstr ""
"Kurulum beklenmeyen bir hatayla durdu; ayrıntılar yalnızca sunucu günlüğünde"
" ve hiçbir değişiklik uygulanmadı."

#: apps/themes/installer.py
msgid ""
"An unexpected error occurred and no changes were applied; the server "
"administrator can see the details in the logs."
msgstr ""
"Beklenmeyen bir hata oluştu ve hiçbir değişiklik uygulanmadı; sunucu "
"yöneticisi ayrıntıları günlüklerde görebilir."

#: apps/themes/installer.py
#, python-format
msgid ""
"Theme “%(slug)s” version %(value)s was installed (%(file_count)s files); it "
"was not activated."
msgstr ""
"“%(slug)s” teması %(value)s sürümü kuruldu (%(file_count)s dosya); "
"etkinleştirilmedi."

#: apps/themes/manifest.py
#, python-format
msgid "The field “%(key)s” is required in theme.json."
msgstr "theme.json içinde “%(key)s” alanı gerekli."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The field “%(key)s” must be a string of at most %(max_len)s characters."
msgstr "“%(key)s” alanı en fazla %(max_len)s karakterlik bir metin olmalıdır."

#: apps/themes/manifest.py
#, python-format
msgid "File or folder not allowed in the theme root: “%(name)s”."
msgstr "Tema kökünde izin verilmeyen dosya veya klasör: “%(name)s”."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(relative_to)s”."
msgstr "Sembolik bağlantılara izin verilmez: “%(relative_to)s”."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(rel)s”."
msgstr "Sembolik bağlantılara izin verilmez: “%(rel)s”."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The file type of “%(rel)s” is not allowed in a theme (only files that cannot"
" run on the server)."
msgstr ""
"“%(rel)s” dosya türüne bir temada izin verilmez (yalnızca sunucuda "
"çalıştırılamayan dosyalar)."

#: apps/themes/manifest.py
#, python-format
msgid "The templates folder accepts only html files: “%(rel)s”."
msgstr "Şablonlar klasörü yalnızca html dosyalarını kabul eder: “%(rel)s”."

#: apps/themes/manifest.py
#, python-format
msgid ""
"html files are not allowed in the static folder: “%(rel)s” (html templates "
"must be in templates)."
msgstr ""
"static klasöründe html dosyalarına izin verilmez: “%(rel)s” (html şablonları"
" templates içinde olmalıdır)."

#: apps/themes/manifest.py
#, python-format
msgid "The size of file “%(rel)s” exceeds the limit."
msgstr "“%(rel)s” dosyasının boyutu sınırı aşıyor."

#: apps/themes/manifest.py apps/themes/package.py
#, python-format
msgid "The number of theme files exceeds %(MAX_FILES)s."
msgstr "Tema dosyalarının sayısı %(MAX_FILES)s değerini aşıyor."

#: apps/themes/manifest.py
#, python-format
msgid "The required template “%(name)s” does not exist."
msgstr "Gerekli “%(name)s” şablonu yok."

#: apps/themes/manifest.py
#, python-format
msgid "The file “%(rel)s” must be valid UTF-8 text."
msgstr "“%(rel)s” dosyası geçerli UTF-8 metni olmalıdır."

#: apps/themes/manifest.py
#, python-format
msgid ""
"Loading the library “%(lib)s” in “%(rel)s” is not allowed (only ravix_theme "
"and i18n)."
msgstr ""
"“%(rel)s” içinde “%(lib)s” kitaplığının yüklenmesine izin verilmez (yalnızca"
" ravix_theme ve i18n)."

#: apps/themes/manifest.py
#, python-format
msgid "The {%% debug %%} tag is not allowed in “%(rel)s”."
msgstr "{%% debug %%} etiketine “%(rel)s” içinde izin verilmez."

#: apps/themes/manifest.py
#, python-format
msgid "Syntax error in “%(rel)s”: %(exc)s"
msgstr "“%(rel)s” içinde sözdizimi hatası: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid "base.html must use the {%% %(tag)s %%} tag."
msgstr "base.html, {%% %(tag)s %%} etiketini kullanmalıdır."

#: apps/themes/manifest.py
msgid ""
"The theme folder name may only contain lowercase English letters, digits, "
"“-” and “_”."
msgstr ""
"Tema klasörü adı yalnızca küçük İngilizce harfler, rakamlar, “-” ve “_” "
"içerebilir."

#: apps/themes/manifest.py
msgid "The theme folder cannot be a symbolic link."
msgstr "Tema klasörü sembolik bağlantı olamaz."

#: apps/themes/manifest.py
msgid "The theme.json file was not found."
msgstr "theme.json dosyası bulunamadı."

#: apps/themes/manifest.py
msgid "theme.json cannot be a symbolic link."
msgstr "theme.json sembolik bağlantı olamaz."

#: apps/themes/manifest.py
msgid "The size of theme.json exceeds the limit."
msgstr "theme.json boyutu sınırı aşıyor."

#: apps/themes/manifest.py
msgid "theme.json must be a JSON object."
msgstr "theme.json bir JSON nesnesi olmalıdır."

#: apps/themes/manifest.py
#, python-format
msgid "theme.json is not valid: %(exc)s"
msgstr "theme.json geçerli değil: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid ""
"api_version must be %(API_VERSION)s (the theme was built for another version"
" of the contract)."
msgstr ""
"api_version %(API_VERSION)s olmalıdır (tema, sözleşmenin başka bir sürümü "
"için hazırlanmış)."

#: apps/themes/manifest.py
msgid ""
"The “slug” value in theme.json must match the theme folder name exactly."
msgstr ""
"theme.json içindeki “slug” değeri tema klasörü adıyla tam olarak "
"eşleşmelidir."

#: apps/themes/manifest.py
msgid "“version” must be in semantic versioning form (e.g. 1.0.0)."
msgstr "“version” anlamsal sürümleme biçiminde olmalıdır (örn. 1.0.0)."

#: apps/themes/manifest.py
msgid "“ravix” must be a version range (e.g. >=0.6,<1.0)."
msgstr "“ravix” bir sürüm aralığı olmalıdır (örn. >=0.6,<1.0)."

#: apps/themes/manifest.py
msgid ""
"The “screenshot” path is invalid (it must be a png/jpg/webp file inside "
"static)."
msgstr ""
"“screenshot” yolu geçersiz (static içinde bir png/jpg/webp dosyası "
"olmalıdır)."

#: apps/themes/manifest.py
msgid "The templates folder does not exist."
msgstr "Şablonlar klasörü yok."

#: apps/themes/manifest.py
msgid "The theme folder does not exist."
msgstr "Tema klasörü yok."

#: apps/themes/models.py
msgid "Active theme"
msgstr "Etkin tema"

#: apps/themes/models.py
msgid "Published configuration"
msgstr "Yayımlanan yapılandırma"

#: apps/themes/models.py
msgid "Draft changes"
msgstr "Taslak değişiklikleri"

#: apps/themes/models.py
msgid "Last draft edit"
msgstr "Son taslak düzenlemesi"

#: apps/themes/models.py
msgid "Last publish time"
msgstr "Son yayımlama zamanı"

#: apps/themes/models.py
msgid "Published by"
msgstr "Yayımlayan"

#: apps/themes/models.py
msgid "Site appearance settings"
msgstr "Site görünümü ayarları"

#: apps/themes/models.py
#, python-format
msgid "Active theme: %(active_theme)s"
msgstr "Etkin tema: %(active_theme)s"

#: apps/themes/package.py
msgid "This file is not a valid ZIP (the file signature does not match ZIP)."
msgstr "Bu dosya geçerli bir ZIP değil (dosya imzası ZIP ile eşleşmiyor)."

#: apps/themes/package.py
msgid "The ZIP file is corrupted or incomplete and could not be opened."
msgstr "ZIP dosyası bozuk veya eksik ve açılamadı."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "ZIP’te güvenli olmayan ad (ters eğik çizgi): “%(show)s”."

#: apps/themes/package.py
msgid "Unsafe name in ZIP (control character)."
msgstr "ZIP’te güvenli olmayan ad (kontrol karakteri)."

#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "ZIP’te mutlak yollara izin verilmez: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr "ZIP’te güvenli olmayan yol (. veya .. veya boş bölüm): “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "“%(show)s” yolu çok uzun veya çok derin."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters,"
" no leading dot)."
msgstr ""
"“%(show)s” adına izin verilmiyor; dosya ve klasör adları yalnızca İngilizce "
"harfler, rakamlar, “.”, “-” ve “_” içerebilir (boşluk yok, Farsça karakter "
"yok, başta nokta yok)."

#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "Uzantısız dosyaya izin verilmez: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"Bir temada çalıştırılabilir veya betik dosyasına izin verilmez (py veya php "
"gibi): “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"SVG files are not allowed in this version: “%(show)s”. Use png, webp or jpg "
"instead."
msgstr ""
"Bu sürümde SVG dosyalarına izin verilmez: “%(show)s”. Bunun yerine png, webp"
" veya jpg kullanın."

#: apps/themes/package.py
#, python-format
msgid "The file extension of “%(show)s” is not allowed in a theme."
msgstr "“%(show)s” dosya uzantısına bir temada izin verilmez."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "ZIP boş."

#: apps/themes/package.py
#, python-format
msgid ""
"The number of ZIP entries exceeds the limit (at most %(MAX_ZIP_ENTRIES)s)."
msgstr "ZIP girdi sayısı sınırı aşıyor (en fazla %(MAX_ZIP_ENTRIES)s)."

#: apps/themes/package.py
#, python-format
msgid "Symbolic links are not allowed in ZIP: “%(show)s”."
msgstr "ZIP’te sembolik bağlantılara izin verilmez: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid "Special or unusual entries are not allowed in ZIP: “%(show)s”."
msgstr "ZIP’te özel veya olağandışı girdilere izin verilmez: “%(show)s”."

#: apps/themes/package.py
msgid "Encrypted ZIP files are not allowed."
msgstr "Şifreli ZIP dosyalarına izin verilmez."

#: apps/themes/package.py
msgid ""
"The ZIP compression method is not supported (only Deflate or no "
"compression)."
msgstr ""
"ZIP sıkıştırma yöntemi desteklenmiyor (yalnızca Deflate veya sıkıştırmasız)."

#: apps/themes/package.py
#, python-format
msgid "Inconsistent entry in ZIP: “%(show)s”."
msgstr "ZIP’te tutarsız girdi: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid "Duplicate name (or differing only in letter case) in ZIP: “%(show)s”."
msgstr ""
"ZIP’te yinelenen ad (veya yalnızca harf büyüklüğü farklı): “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"“%(show)s” dosyası tema klasörünün dışında. Tüm dosyalar tema kimliğiyle "
"adlandırılmış tek bir klasörün içinde olmalıdır (örn. my-theme/theme.json)."

#: apps/themes/package.py
#, python-format
msgid "The size of file “%(show)s” exceeds %(value)s MB."
msgstr "“%(show)s” dosyasının boyutu %(value)s MB’ı aşıyor."

#: apps/themes/package.py
msgid "The ZIP is suspicious (a zero-size file in the compressed data)."
msgstr "ZIP şüpheli (sıkıştırılmış verilerde sıfır boyutlu bir dosya)."

#: apps/themes/package.py
#, python-format
msgid "The compression ratio of “%(show)s” is unusual (possible zip bomb)."
msgstr "“%(show)s” sıkıştırma oranı olağandışı (olası zip bombası)."

#: apps/themes/package.py
#, python-format
msgid "The total size of the extracted files exceeds %(value)s MB."
msgstr "Çıkarılan dosyaların toplam boyutu %(value)s MB’ı aşıyor."

#: apps/themes/package.py
msgid ""
"The ZIP must have only one root folder (named after the theme ID). If you "
"made the ZIP on macOS, do not include the __MACOSX folder; put the files "
"inside one folder and zip again."
msgstr ""
"ZIP’in yalnızca bir kök klasörü olmalıdır (tema kimliğiyle adlandırılmış). "
"ZIP’i macOS’ta oluşturduysanız __MACOSX klasörünü eklemeyin; dosyaları tek "
"bir klasörün içine koyup yeniden sıkıştırın."

#: apps/themes/package.py
#, python-format
msgid ""
"The root folder name (“%(show)s”) is not a valid theme ID; only lowercase "
"English letters, digits, “-” and “_” (at most 49 characters)."
msgstr ""
"Kök klasör adı (“%(show)s”) geçerli bir tema kimliği değil; yalnızca küçük "
