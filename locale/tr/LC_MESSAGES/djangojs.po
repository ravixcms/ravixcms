msgstr "%(type)s öğesini taşı"

#: static/builder/builder.js
msgid "Previous column"
msgstr "Önceki sütun"

#: static/builder/builder.js
msgid "Up"
msgstr "Yukarı"

#: static/builder/builder.js
msgid "Next column"
msgstr "Sonraki sütun"

#: static/builder/builder.js
