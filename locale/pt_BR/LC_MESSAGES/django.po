#, python-format
msgid "Duplicate name (or differing only in letter case) in ZIP: “%(show)s”."
msgstr ""
"Nome duplicado (ou que difere apenas em maiúsculas/minúsculas) no ZIP: "
"“%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"O arquivo “%(show)s” está fora da pasta do tema. Todos os arquivos devem "
"estar dentro de uma pasta com o ID do tema (por exemplo, my-theme/theme."
"json)."

#: apps/themes/package.py
#, python-format
msgid "The size of file “%(show)s” exceeds %(value)s MB."
msgstr "O tamanho do arquivo “%(show)s” excede %(value)s MB."

