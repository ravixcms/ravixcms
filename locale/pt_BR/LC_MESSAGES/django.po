#, python-format
msgid "The templates folder accepts only html files: “%(rel)s”."
msgstr "A pasta de templates aceita apenas arquivos html: “%(rel)s”."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The locale folder accepts only <language>.json files for the supported "
"languages (for example fr.json or pt-br.json): “%(rel)s”."
msgstr ""
"A pasta locale aceita apenas arquivos <language>.json dos idiomas "
"compatíveis (por exemplo, fr.json ou pt-br.json): “%(rel)s”."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The translation file “%(rel)s” must be a JSON object that maps English text "
"to its translation (text only, within the size limits)."
msgstr ""
"O arquivo de tradução “%(rel)s” deve ser um objeto JSON que associa o texto "
"em inglês à sua tradução (apenas texto, dentro dos limites de tamanho)."

