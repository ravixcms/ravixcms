#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "O caminho “%(show)s” é longo ou profundo demais."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters, "
"no leading dot)."
msgstr ""
"O nome “%(show)s” não é permitido; nomes de arquivos e pastas só podem "
"conter letras inglesas, dígitos, “.”, “-” e “_” (sem espaços, sem caracteres "
"persas, sem ponto no início)."

#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "Um arquivo sem extensão não é permitido: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"Um arquivo executável ou script não é permitido em um tema (como py ou php): "
"“%(show)s”."

#: apps/themes/package.py
#, python-format
msgid ""
"SVG files are not allowed in this version: “%(show)s”. Use png, webp or jpg "
"instead."
msgstr ""
"Arquivos SVG não são permitidos nesta versão: “%(show)s”. Use png, webp ou "
"jpg."

#: apps/themes/package.py
#, python-format
msgid "The file extension of “%(show)s” is not allowed in a theme."
msgstr "A extensão do arquivo “%(show)s” não é permitida em um tema."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "O ZIP está vazio."

#: apps/themes/package.py
#, python-format
msgid ""
"The number of ZIP entries exceeds the limit (at most %(MAX_ZIP_ENTRIES)s)."
msgstr ""
"O número de entradas do ZIP excede o limite (no máximo %(MAX_ZIP_ENTRIES)s)."

