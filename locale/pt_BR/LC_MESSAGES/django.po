#: apps/themes/manifest.py
#, python-format
msgid ""
"The file type of “%(rel)s” is not allowed in a theme (only files that cannot "
"run on the server)."
msgstr ""
"O tipo de arquivo de “%(rel)s” não é permitido em um tema (somente arquivos "
"que não podem ser executados no servidor)."

