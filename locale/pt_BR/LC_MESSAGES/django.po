msgstr "Uma origem por linha, por exemplo https://app.example.com. Aplicativos que não são páginas da web não enviam nenhuma."

msgid "Ravix MCP settings"
msgstr "Configurações do Ravix MCP"

#, python-format
msgid "This app could not be identified, so it cannot be connected. (%(why)s)"
msgstr "Este aplicativo não pôde ser identificado, então não pode ser conectado. (%(why)s)"

