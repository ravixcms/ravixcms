#, python-format
msgid ""
"html files are not allowed in the static folder: “%(rel)s” (html templates "
"must be in templates)."
msgstr ""
"Arquivos html não são permitidos na pasta static: “%(rel)s” (os templates "
"html devem ficar em templates)."

