"2) Files: tar -xzf %(value)s -C %(RAVIX_UPDATE_APP_ROOT)s  (first set aside "
"the apps, config, static, templates, etc. folders)"
msgstr ""
"2) Arquivos: tar -xzf %(value)s -C %(RAVIX_UPDATE_APP_ROOT)s  (primeiro "
