msgid "The ZIP file is corrupted or incomplete and could not be opened."
msgstr "O arquivo ZIP está corrompido ou incompleto e não pôde ser aberto."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "Nome inseguro no ZIP (barra invertida): “%(show)s”."

#: apps/themes/package.py
msgid "Unsafe name in ZIP (control character)."
msgstr "Nome inseguro no ZIP (caractere de controle)."

#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "Caminhos absolutos não são permitidos no ZIP: “%(show)s”."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr "Caminho inseguro no ZIP (. ou .. ou segmento vazio): “%(show)s”."

