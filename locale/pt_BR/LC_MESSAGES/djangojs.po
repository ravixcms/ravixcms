msgid ""
"The address is not allowed; use an internal path (/…), http(s), mailto or "
"tel."
msgstr ""
"O endereço não é permitido; use um caminho interno (/…), http(s), mailto ou "
"tel."

#: static/builder/builder.js
msgid "Page settings"
msgstr "Configurações da página"

