msgid "No image found. First upload an image to the media library."
msgstr ""
"Nenhuma imagem encontrada. Primeiro envie uma imagem para a biblioteca de "
"mídia."

#: static/builder/builder.js
msgid "Saved."
msgstr "Salvo."

#: static/builder/builder.js
msgid "Publish"
msgstr "Publicar"

#: static/builder/builder.js
msgid "Submit for approval"
msgstr "Enviar para aprovação"

#: static/builder/builder.js
msgid "Publish this layout on the site"
msgstr "Publicar este layout no site"

#: static/builder/builder.js
msgid "The layout is sent to an administrator for approval"
msgstr "O layout é enviado a um administrador para aprovação"

#: static/builder/builder.js
msgid "Saving the draft must succeed first."
msgstr "Primeiro é preciso salvar o rascunho com sucesso."

#: static/builder/builder.js
msgid "Publish layout"
msgstr "Publicar layout"

#: static/builder/builder.js
msgid ""
"The current draft replaces the page content on the site. (The page’s own "
"status — published or draft — is controlled in the “Pages” section.)"
msgstr ""
"O rascunho atual substitui o conteúdo da página no site. (O status da "
"própria página — publicada ou rascunho — é controlado na seção “Páginas”.)"

#: static/builder/builder.js
msgid "The layout was published."
msgstr "O layout foi publicado."

#: static/builder/builder.js
msgid ""
"It will be published on the site after an administrator approves it. Until "
"then the current page is shown."
msgstr ""
"Ele será publicado no site depois que um administrador o aprovar. Até lá, a "
"página atual é exibida."

#: static/builder/builder.js
msgid "Submitted for approval."
msgstr "Enviado para aprovação."

#: static/builder/builder.js
msgid "The version was saved."
msgstr "A versão foi salva."

#: static/builder/builder.js
msgid "Unpublish the layout? The page goes back to its previous text content."
msgstr "Despublicar o layout? A página volta ao conteúdo de texto anterior."

#: static/builder/builder.js
msgid "The layout was unpublished."
msgstr "O layout foi despublicado."

#: static/builder/builder.js
msgid "No version has been saved yet."
msgstr "Nenhuma versão foi salva ainda."

