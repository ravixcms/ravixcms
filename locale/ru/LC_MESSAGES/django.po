msgid "Header"
msgstr "Шапка"

#: apps/themes/services.py templates/themes/customize_layout.html
msgid "Footer"
msgstr "Подвал"

#: apps/themes/services.py templates/themes/_status.html
msgid "Menus"
msgstr "Меню"

