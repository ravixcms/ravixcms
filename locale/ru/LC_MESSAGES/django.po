msgstr "Отозвано."

#: apps/pluginhub/views.py
msgid "Draft deleted."
msgstr "Черновик удалён."

#: apps/pluginhub/views.py
#, python-format
msgid "Version %(version)s of plugin “%(slug)s”: %(msg)s"
msgstr "Версия %(version)s плагина «%(slug)s»: %(msg)s"

#: apps/pluginhub/views.py
#, python-format
msgid "Version %(version)s %(msg)s"
msgstr "Версия %(version)s %(msg)s"

#: apps/pluginhub/views.py
