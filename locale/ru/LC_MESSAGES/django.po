#, python-format
msgid "The site appearance draft was saved (section %(labels)s)."
msgstr "Черновик внешнего вида сайта сохранён (раздел %(labels)s)."

#: apps/themes/services.py
#, python-format
msgid "Preview of theme “%(display_name)s” started."
msgstr "Предпросмотр темы «%(display_name)s» запущен."

