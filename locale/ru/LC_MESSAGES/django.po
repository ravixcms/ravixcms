msgstr "Плагин %(slug)s"

#: apps/plugins/apps.py templates/plugins/events.html
#: templates/plugins/list.html
msgid "Plugin log"
msgstr "Журнал плагинов"

#: apps/plugins/discovery.py
msgid "The plugin folder must not be a symlink."
msgstr "Папка плагина не должна быть символической ссылкой."

#: apps/plugins/discovery.py
msgid "The __init__.py file is missing."
msgstr "Файл __init__.py отсутствует."

#: apps/plugins/discovery.py
#, python-format
msgid ""
"The plugin folder %(path)s cannot be read by the web service, so the plugins"
" in it are not listed. Give the service user read access "
"(SupplementaryGroups=ravix in ravix.service, then restart) and run "
"ravix_preflight."
msgstr ""
"Веб-служба не может прочитать папку плагинов (%(path)s), поэтому плагины в "
"ней не показаны. Дайте пользователю службы доступ на чтение "
"(SupplementaryGroups=ravix в ravix.service, затем перезапуск) и запустите "
"ravix_preflight."

#: apps/plugins/discovery.py
#, python-format
msgid "Duplicate slug; the version in folder %(path)s takes priority."
msgstr "Повторяющийся slug; приоритет у версии в папке %(path)s."

#: apps/plugins/events.py
#, python-format
msgid ""
"The plugin was automatically disabled because of %(recent)s errors within "
"%(window)s seconds."
msgstr ""
"Плагин автоматически отключён из-за %(recent)s ошибок за %(window)s секунд."

#: apps/plugins/installer.py apps/plugins/services.py
msgid "Only an administrator may do this."
msgstr "Это может сделать только администратор."

#: apps/plugins/installer.py
msgid ""
"Web installation is off. To enable it, set RAVIX_PLUGIN_WEB_INSTALL=true in "
"the server settings (only when you have made the install folder writable for"
" the service)."
msgstr ""
"Веб-установка отключена. Чтобы включить её, задайте "
"RAVIX_PLUGIN_WEB_INSTALL=true в настройках сервера (только после того, как "
"сделаете папку установки доступной для записи службе)."

#: apps/plugins/installer.py
msgid "The plugin system is off."
msgstr "Система плагинов отключена."

#: apps/plugins/installer.py apps/themes/installer.py
msgid "A core or theme upgrade is in progress; try again after it finishes."
msgstr "Идёт обновление ядра или темы; повторите после завершения."

#: apps/plugins/installer.py
msgid "Another operation is in progress on this plugin; try again shortly."
msgstr "С этим плагином выполняется другая операция; повторите чуть позже."

#: apps/plugins/installer.py
msgid "Unexpected error"
msgstr "Непредвиденная ошибка"

#: apps/plugins/installer.py
msgid ""
"An unexpected error occurred and no change was applied; technical details "
"were recorded in the “Plugin log”."
msgstr ""
"Произошла непредвиденная ошибка, изменения не применены; технические "
"подробности записаны в «Журнал плагинов»."

#: apps/plugins/installer.py
msgid ""
"The file’s SHA-256 does not match the declared value; the file is corrupt or"
" tampered with and was discarded."
msgstr ""
"SHA-256 файла не совпадает с заявленным значением; файл повреждён или "
"подменён и был отброшен."

#: apps/plugins/installer.py
#, python-format
msgid "The package is not valid: %(exc)s"
msgstr "Пакет недопустим: %(exc)s"

#: apps/plugins/installer.py
#, python-format
msgid ""
"The identifier inside the package (“%(slug)s”) does not match the request "
"(“%(expected_slug)s”)."
msgstr ""
"Идентификатор внутри пакета («%(slug)s») не совпадает с запросом "
"(«%(expected_slug)s»)."

#: apps/plugins/installer.py
#, python-format
msgid ""
"The version inside the package (%(version)s) does not match the requested "
"version (%(expected_version)s)."
msgstr ""
"Версия внутри пакета (%(version)s) не совпадает с запрошенной "
"(%(expected_version)s)."

#: apps/plugins/installer.py
msgid "The package content fingerprint does not match the registry."
msgstr "Отпечаток содержимого пакета не совпадает с реестром."

#: apps/plugins/installer.py
#, python-format
msgid "This package is not compatible with this system: %(problems)s"
msgstr "Этот пакет несовместим с данной системой: %(problems)s"

#: apps/plugins/installer.py
#, python-format
msgid "The digital signature is invalid: %(reason)s"
msgstr "Цифровая подпись недействительна: %(reason)s"

#: apps/plugins/installer.py
msgid ""
"The package has no valid digital signature and this site’s policy does not "
"accept unsigned packages (registry packages must always be signed)."
msgstr ""
"У пакета нет действительной цифровой подписи, а политика этого сайта не "
"принимает неподписанные пакеты (пакеты реестра должны быть подписаны "
"всегда)."

#: apps/plugins/installer.py
#, python-format
msgid "Extracting the package failed: %(exc)s"
msgstr "Не удалось распаковать пакет: %(exc)s"

#: apps/plugins/installer.py
msgid ""
"The extracted content does not match the validated package; the operation "
"was stopped."
msgstr ""
"Распакованное содержимое не совпадает с проверенным пакетом; операция "
"остановлена."

#: apps/plugins/installer.py
msgid "This plugin is already installed; use “Upgrade” for a new version."
msgstr "Этот плагин уже установлен; для новой версии используйте «Обновить»."

#: apps/plugins/installer.py
#, python-format
msgid ""
"A folder named “%(slug)s” already exists on the server; we will not "
"overwrite it."
msgstr "На сервере уже есть папка «%(slug)s»; мы её не перезапишем."

#: apps/plugins/installer.py
#, python-format
msgid ""
"The install folder is not writable (%(strerror)s). Check the permissions of "
"RAVIX_PLUGIN_INSTALL_DIR."
msgstr ""
"Папка установки недоступна для записи (%(strerror)s). Проверьте права "
"RAVIX_PLUGIN_INSTALL_DIR."

#: apps/plugins/installer.py
#, python-format
msgid "The final placement failed: %(strerror)s"
msgstr "Не удалось выполнить окончательное размещение: %(strerror)s"

#: apps/plugins/installer.py
#, python-format
msgid ""
"Package %(version)s (%(source_label)s) was placed; awaiting review and "
"installation."
msgstr ""
"Пакет %(version)s (%(source_label)s) размещён; ожидает проверки и установки."

#: apps/plugins/installer.py
msgid "Valid signature: "
msgstr "Подпись действительна: "

#: apps/plugins/installer.py templates/plugins/detail.html
msgid "Unsigned"
msgstr "Без подписи"

#: apps/plugins/installer.py
#, python-format
msgid "%(source)s, %(sig)s"
msgstr "%(source)s, %(sig)s"

#: apps/plugins/installer.py
#, python-format
msgid ""
"Creating the backup failed and the operation was not performed: %(exc)s"
msgstr "Не удалось создать резервную копию, операция не выполнена: %(exc)s"

#: apps/plugins/installer.py
msgid "The backup path is invalid."
msgstr "Путь резервной копии недопустим."

#: apps/plugins/installer.py
msgid "The backup file was not found."
msgstr "Файл резервной копии не найден."

#: apps/plugins/installer.py
msgid ""
"The integrity of the backup file could not be verified (SHA-256 mismatch); "
"restoring from it is forbidden."
msgstr ""
"Не удалось проверить целостность файла резервной копии (несовпадение "
"SHA-256); восстановление из неё запрещено."

#: apps/plugins/installer.py apps/plugins/registry.py
msgid "The plugin folder was not found."
msgstr "Папка плагина не найдена."

#: apps/plugins/installer.py
msgid ""
"This plugin was placed manually (outside the automatic install folder); "
"automatic upgrade and rollback are not possible for it."
msgstr ""
"Этот плагин размещён вручную (вне папки автоматической установки); "
"автоматическое обновление и откат для него невозможны."

#: apps/plugins/installer.py
#, python-format
msgid "Replacement failed (no change): %(strerror)s"
msgstr "Замена не удалась (без изменений): %(strerror)s"

#: apps/plugins/installer.py
#, python-format
msgid "Replacement failed and the previous version was restored: %(strerror)s"
msgstr "Замена не удалась, предыдущая версия восстановлена: %(strerror)s"

#: apps/plugins/installer.py
msgid "This plugin is not installed yet."
msgstr "Этот плагин ещё не установлен."

#: apps/plugins/installer.py
#, python-format
msgid ""
"The package version (%(version)s) is not newer than the installed version "
"(%(version2)s); use “Rollback” for an earlier version."
msgstr ""
"Версия пакета (%(version)s) не новее установленной (%(version2)s); для более"
" ранней версии используйте «Откатить»."

#: apps/plugins/installer.py
msgid ""
"The current plugin code does not match the approved version; approve or "
"revert the changes first."
msgstr ""
"Текущий код плагина не совпадает с одобренной версией; сначала одобрите или "
"отмените изменения."

#: apps/plugins/installer.py
#, python-format
msgid ""
"Code replaced %(version)s → %(version2)s (backup #%(pk)s). To continue, you "
"must approve the changes and enable the plugin again."
msgstr ""
"Код заменён %(version)s → %(version2)s (резервная копия №%(pk)s). Чтобы "
"продолжить, нужно одобрить изменения и снова включить плагин."

#: apps/plugins/installer.py
msgid "The backup was not found."
msgstr "Резервная копия не найдена."

#: apps/plugins/installer.py
msgid "This backup has already been used."
msgstr "Эта резервная копия уже использована."

#: apps/plugins/installer.py
msgid ""
"The backup content does not match the recorded fingerprint; the rollback was"
" stopped."
msgstr ""
"Содержимое резервной копии не совпадает с записанным отпечатком; откат "
"остановлен."

#: apps/plugins/installer.py
#, python-format
msgid "The backup cannot be used: %(exc)s"
msgstr "Резервную копию нельзя использовать: %(exc)s"

#: apps/plugins/installer.py
msgid "A folder with this name now exists; restoring does not overwrite."
msgstr ""
"Папка с таким именем уже существует; восстановление её не перезаписывает."

#: apps/plugins/installer.py
#, python-format
msgid ""
"The files of version %(version)s were restored from the backup (it must be "
"installed again before use)."
msgstr ""
"Файлы версии %(version)s восстановлены из резервной копии (перед "
"использованием её нужно установить снова)."

#: apps/plugins/installer.py
msgid ""
"Rolling back must reverse the database migrations of the newer version and "
"the data they added will be deleted. After taking a database backup, tick "
"the confirmation option."
msgstr ""
"При откате нужно отменить миграции базы данных более новой версии, и "
"добавленные ими данные будут удалены. Сделав резервную копию базы данных, "
"отметьте подтверждение."

#: apps/plugins/installer.py
#, python-format
msgid ""
"Reversing the database migration failed; the files were left untouched. Use "
"the database backup. (%(exc)s)"
msgstr ""
"Не удалось отменить миграцию базы данных; файлы остались нетронутыми. "
"Используйте резервную копию базы данных. (%(exc)s)"

#: apps/plugins/installer.py
#, python-format
msgid ""
"Rolled back to version %(version)s. The plugin is disabled; enable it again "
"after review."
msgstr ""
"Выполнен откат к версии %(version)s. Плагин отключён; включите его снова "
"после проверки."

#: apps/plugins/installer.py
msgid "Uninstall the plugin first."
msgstr "Сначала удалите плагин."

#: apps/plugins/installer.py
msgid "This folder was placed manually; delete the files yourself."
msgstr "Эта папка размещена вручную; удалите файлы сами."

#: apps/plugins/installer.py
#, python-format
msgid "The plugin files were deleted (backup #%(pk)s)."
msgstr "Файлы плагина удалены (резервная копия №%(pk)s)."

#: apps/plugins/integrity.py
#, python-format
msgid "Symbolic links (symlinks) are not allowed: %(d)s"
msgstr "Символические ссылки (symlinks) не разрешены: %(d)s"

#: apps/plugins/integrity.py
#, python-format
msgid "Unusual files/symbolic links are not allowed: %(relative_to)s"
msgstr "Необычные файлы/символические ссылки не разрешены: %(relative_to)s"

#: apps/plugins/integrity.py
msgid "The plugin exceeds the file count/size limit."
msgstr "Плагин превышает предел по количеству/размеру файлов."

#: apps/plugins/manifest.py
#, python-format
msgid "%(key)s: must be text."
msgstr "%(key)s: должно быть текстом."

#: apps/plugins/manifest.py
msgid "plugin.json must be a JSON object."
msgstr "plugin.json должен быть объектом JSON."

#: apps/plugins/manifest.py
#, python-format
msgid "%(k)s: unknown key."
msgstr "%(k)s: неизвестный ключ."

#: apps/plugins/manifest.py
msgid ""
"slug: lowercase English letters, digits and _ (3 to 31 characters, starting "
"with a letter)."
msgstr ""
"slug: строчные английские буквы, цифры и _ (от 3 до 31 символа, начинается с"
" буквы)."

#: apps/plugins/manifest.py
#, python-format
msgid "slug: “%(slug)s” is reserved."
msgstr "slug: «%(slug)s» зарезервирован."

#: apps/plugins/manifest.py
#, python-format
msgid "slug: must match the folder name (%(expected_slug)s)."
msgstr "slug: должен совпадать с именем папки (%(expected_slug)s)."

#: apps/plugins/manifest.py
msgid "version: must look like 1.2.3."
msgstr "version: должна выглядеть как 1.2.3."

#: apps/plugins/manifest.py apps/themes/manifest.py
msgid "homepage: not a valid http(s) address."
msgstr "homepage: недопустимый адрес http(s)."

#: apps/plugins/manifest.py
msgid "api_version: an integer is required."
msgstr "api_version: требуется целое число."

#: apps/plugins/manifest.py
#, python-format
msgid ""
"api_version: this CMS supports contract version %(PLUGIN_API_VERSION)s "
"(plugin: %(api)s)."
msgstr ""
"api_version: эта CMS поддерживает версию контракта %(PLUGIN_API_VERSION)s "
"(плагин: %(api)s)."

#: apps/plugins/manifest.py
msgid "ravix: invalid version range (e.g. >=0.5.0,<1.0.0)."
msgstr "ravix: недопустимый диапазон версий (например, >=0.5.0,<1.0.0)."

#: apps/plugins/manifest.py
msgid "requires: must be an object {slug: range}."
msgstr "requires: должен быть объектом {slug: range}."

#: apps/plugins/manifest.py
#, python-format
msgid "requires.%(dep)s: invalid."
msgstr "requires.%(dep)s: недопустимо."

#: apps/plugins/manifest.py
msgid "requires: dependency on the plugin itself."
msgstr "requires: зависимость плагина от самого себя."

#: apps/plugins/manifest.py
msgid "capabilities: must be an object {name: label}."
msgstr "capabilities: должен быть объектом {name: label}."

#: apps/plugins/manifest.py
#, python-format
msgid ""
"capabilities.%(cap)s: must start with “%(slug)s.” (the plugin namespace); "
"core permissions cannot be redefined."
msgstr ""
"capabilities.%(cap)s: должно начинаться с «%(slug)s.» (пространство имён "
"плагина); права ядра нельзя переопределять."

#: apps/plugins/manifest.py
#, python-format
msgid "capabilities.%(cap)s: conflicts with a core permission."
msgstr "capabilities.%(cap)s: конфликтует с правом ядра."

#: apps/plugins/manifest.py
#, python-format
msgid "capabilities.%(cap)s: a label is required."
msgstr "capabilities.%(cap)s: требуется метка."

#: apps/plugins/manifest.py
msgid "settings: a list of at most 40 items is required."
msgstr "settings: требуется список не более чем из 40 элементов."

#: apps/plugins/manifest.py
#, python-format
msgid "settings[%(i)s].key: duplicate."
msgstr "settings[%(i)s].key: дубликат."

#: apps/plugins/manifest.py
msgid "admin_pages: a list of at most 20 items is required."
msgstr "admin_pages: требуется список не более чем из 20 элементов."

#: apps/plugins/manifest.py apps/plugins/settings_schema.py
#, python-format
msgid "%(where)s: must be an object."
msgstr "%(where)s: должен быть объектом."

#: apps/plugins/manifest.py apps/plugins/settings_schema.py
#, python-format
msgid "%(where)s.%(k)s: unknown key."
msgstr "%(where)s.%(k)s: неизвестный ключ."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.key: invalid or duplicate."
msgstr "%(where)s.key: недопустимо или дубликат."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.title: required (at most 60)."
msgstr "%(where)s.title: обязательно (не более 60)."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.view: must look like “module:function”."
msgstr "%(where)s.view: должно выглядеть как «module:function»."

#: apps/plugins/manifest.py
#, python-format
msgid ""
"%(where)s.capability: must be a core permission or a permission declared by "
"this plugin."
msgstr ""
"%(where)s.capability: должно быть правом ядра или правом, объявленным этим "
"плагином."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.section: one of %(SECTIONS)s."
msgstr "%(where)s.section: одно из %(SECTIONS)s."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.order: a number from 0 to 999."
msgstr "%(where)s.order: число от 0 до 999."

#: apps/plugins/manifest.py
msgid "public_routes: a list of at most 20 items is required."
msgstr "public_routes: требуется список не более чем из 20 элементов."

#: apps/plugins/manifest.py
#, python-format
msgid ""
"%(where)s.path: invalid or duplicate (lowercase letters, digits, - _ and /)."
msgstr ""
"%(where)s.path: недопустимо или дубликат (строчные буквы, цифры, - _ и /)."

#: apps/plugins/manifest.py
#, python-format
msgid "%(where)s.methods: a subset of [GET, POST]."
msgstr "%(where)s.methods: подмножество [GET, POST]."

#: apps/plugins/manifest.py
msgid "hooks: a list of at most 20 items is required."
