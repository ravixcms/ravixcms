#: apps/themes/services.py
#, python-format
msgid "The site appearance changes were published (theme “%(display_name)s”)."
msgstr "Изменения внешнего вида сайта опубликованы (тема «%(display_name)s»)."

#: apps/themes/services.py
msgid "This theme is already active."
msgstr "Эта тема уже активна."

#: apps/themes/services.py
#, python-format
msgid "Theme “%(display_name)s” was activated."
msgstr "Тема «%(display_name)s» активирована."

#: apps/themes/services.py
msgid ""
"The default theme cannot be deactivated; to change the appearance, activate "
"another theme."
msgstr ""
"Тему по умолчанию нельзя отключить; чтобы изменить внешний вид, активируйте "
