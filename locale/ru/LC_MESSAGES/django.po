msgstr "Издатель авторизован."

#: apps/pluginhub/views.py
#, python-format
msgid "Publisher “%(display_name)s”: %(field)s=%(pub)s"
msgstr "Издатель «%(display_name)s»: %(field)s=%(pub)s"

#: apps/pluginhub/views.py
msgid "Deleted."
msgstr "Удалено."

#: apps/pluginhub/views.py
msgid "Category added."
msgstr "Категория добавлена."

#: apps/pluginhub/views.py
#, python-format
msgid "Plugin “%(slug)s” was %(value)s"
msgstr "Плагин «%(slug)s» %(value)s"

#: apps/pluginhub/views.py
msgid "listed"
msgstr "добавлен в список"

#: apps/pluginhub/views.py
msgid "removed from the listing"
msgstr "убран из списка"

#: apps/pluginhub/views.py
msgid "by the registry administrator"
msgstr "администратором реестра"

#: apps/pluginhub/views.py
#, python-format
msgid ""
"Version %(version)s of plugin “%(slug)s” was withdrawn by the registry "
"administrator"
msgstr ""
"Версия %(version)s плагина «%(slug)s» отозвана администратором реестра"

#: apps/pluginhub/views.py apps/plugins/views.py
msgid "Done."
msgstr "Готово."

#: apps/plugins/api.py apps/plugins/services.py
#, python-format
