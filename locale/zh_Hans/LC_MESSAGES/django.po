msgstr ""
"请为真实 SMTP 填写 DJANGO_EMAIL_BACKEND 以及 "
"EMAIL_HOST/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD 设置。"

#: apps/core/sitehealth.py
msgid ""
"SMTP is configured on this same server without authentication; most emails "
