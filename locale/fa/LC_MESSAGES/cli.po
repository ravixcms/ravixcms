# Ravix operator-facing text (management commands, start-up errors, preflight, logs): Persian.
# Source of truth is this file; msgids are English. Compile with: msgfmt -o cli.mo cli.po
msgid ""
msgstr ""
"Project-Id-Version: Ravix\n"
"PO-Revision-Date: 2026-10-23 12:00+0000\n"
"Last-Translator: Ravix\n"
"Language-Team: Persian\n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#, python-format
msgid ""
"\n"
"%(a1)s passed, %(a2)s warnings, %(a3)s errors"
msgstr ""
"\n"
"%(a1)s موفق، %(a2)s هشدار، %(a3)s خطا"

msgid " — rename them to RAVIX_* (they are removed in 2.0; docs/upgrade.md)"
msgstr " — به نام RAVIX_* تغییر دهید (در 2.0 حذف می‌شوند؛ docs/upgrade.md)"

msgid " — use ravix_preflight instead"
msgstr " — به‌جای آن ravix_preflight"

msgid " — use ravix_release instead"
msgstr " — به‌جای آن ravix_release"

msgid " — use ravix_update instead"
msgstr " — به‌جای آن ravix_update"

#, python-format
msgid "%(a1)s inconclusive transactions were closed."
msgstr "%(a1)s تراکنش بی‌نتیجه بسته شد."

#, python-format
msgid "%(a1)s migrations have not been applied; run migrate"
msgstr "%(a1)s مهاجرت اجرا نشده؛ migrate را اجرا کنید"

#, python-format
msgid "%(a1)s orders were cancelled."
msgstr "%(a1)s سفارش لغو شد."

#, python-format
msgid "%(bad)s plugins have problems."
msgstr "%(bad)s افزونه مشکل دارد."

#, python-format
msgid "%(bad)s themes are invalid or missing."
msgstr "%(bad)s قالب نامعتبر یا ناموجود است."

#, python-format
msgid "%(count)s posts were published."
msgstr "%(count)s نوشته منتشر شد."

#, python-format
msgid "%(n)s events were deleted."
msgstr "%(n)s رویداد حذف شد."

#, python-format
msgid "%(n)s versions were signed."
msgstr "%(n)s نسخه امضا شد."

#, python-format
msgid "%(n_pages)s pages and %(n_posts)s posts have a slug equal to a language code (for example /de/ is now the German home page). Run: python manage.py ravix_fix_slugs"
msgstr "%(n_pages)s برگه و %(n_posts)s نوشته نامکی برابر کد زبان دارند (مثلاً /de/ حالا صفحهٔ اصلی آلمانی است). اجرا کنید: python manage.py ravix_fix_slugs"

#, python-format
msgid "%(slug)s %(a2)s was placed (SHA-256 and signature verified: %(a3)s)."
msgstr "%(slug)s %(a2)s قرار گرفت (SHA-256 و امضا تأیید شد: %(a3)s)."

#, python-format
msgid "%(stuck)s upgrades need manual recovery (panel → Updates)"
msgstr "%(stuck)s ارتقا نیازمند بازیابی دستی است (پنل ← به‌روزرسانی‌ها)"

#, python-format
msgid "%(target)s already exists."
msgstr "%(target)s از قبل وجود دارد."

#, python-format
msgid "%(where)s: key “%(key)s”"
msgstr "%(where)s: کلید «%(key)s»"

msgid "(Development only) Creates the migrations of a plugin. The code is loaded without approval; allowed only with DEBUG=True."
msgstr "(فقط توسعه) مهاجرت‌های یک افزونه را می‌سازد. کد بدون تأیید بارگذاری می‌شود؛ فقط با DEBUG=True مجاز است."

msgid ", "
msgstr "، "

msgid "--allow-insecure is allowed only with DEBUG on."
msgstr "--allow-insecure فقط با DEBUG روشن مجاز است."

msgid "--key-file is required."
msgstr "--key-file لازم است."

msgid "--run is required."
msgstr "--run لازم است."

msgid "--slug and --user (administrator) are required."
msgstr "--slug و --user (مدیر) لازم است."

msgid "--slug is required."
msgstr "--slug لازم است."

msgid "--theme-dir is required."
msgstr "--theme-dir لازم است."

msgid "; "
msgstr "؛ "

#, python-format
msgid "A new theme based on the theme “%s”; edit this description."
msgstr "قالب جدید بر پایهٔ قالب «%s»؛ این توضیح را ویرایش کنید."

#, python-format
msgid "A theme with the slug “%(slug)s” already exists."
msgstr "قالبی با نامک «%(slug)s» از قبل وجود دارد."

msgid "A trusted public key for package signatures is configured"
msgstr "کلید عمومی مورد اعتماد برای امضای بسته‌ها تنظیم شده"

msgid "A trusted signing key is defined"
msgstr "کلید مورد اعتماد برای امضا تعریف شده"

msgid "ALLOWED_HOSTS is empty or *"
msgstr "ALLOWED_HOSTS خالی یا * است"

msgid "ALLOWED_HOSTS is set"
msgstr "ALLOWED_HOSTS مشخص است"

#, python-format
msgid "Active lock: %(a1)s since %(a2)s"
msgstr "قفل فعال: %(a1)s از %(a2)s"

msgid "Active payment gateway(s): "
msgstr "درگاه(های) پرداخت فعال: "

msgid "Administrator username/email (required for plugins)"
msgstr "نام‌کاربری/ایمیل مدیر (برای افزونه‌ها لازم است)"

msgid "All migrations have been applied"
msgstr "همهٔ مهاجرت‌ها اجرا شده"

msgid "Also create a database model"
msgstr "مدل دیتابیس هم داشته باشد"

msgid "An update source is configured"
msgstr "منبع به‌روزرسانی تنظیم شده"

msgid "Applying upgrades from the web is off (recommended)"
msgstr "اعمال ارتقا از وب خاموش است (توصیه‌شده)"

msgid "Author name"
msgstr "نام سازنده"

msgid "Before cancelling, asks the gateway; then cancels overdue unpaid orders, restores stock and closes inconclusive transactions. Run it with a timer every few minutes."
msgstr "پیش از لغو، از درگاه استعلام می‌گیرد؛ سپس سفارش‌های پرداخت‌نشدهٔ از مهلت گذشته را لغو و موجودی را برمی‌گرداند و تراکنش‌های بی‌نتیجه را می‌بندد. با تایمر هر چند دقیقه اجرا شود."

msgid "Blocker: "
msgstr "مانع: "

msgid "Builds a core/theme package, signs it and generates index.json for release (on the publisher's machine)."
msgstr "ساخت بستهٔ هسته/قالب، امضا و تولید index.json برای انتشار (روی ماشین ناشر)."

msgid "CSRF_TRUSTED_ORIGINS is empty (usually required behind HTTPS with a domain)"
msgstr "CSRF_TRUSTED_ORIGINS خالی است (پشت HTTPS با دامنه، معمولاً لازم است)"

msgid "CSRF_TRUSTED_ORIGINS is set"
msgstr "CSRF_TRUSTED_ORIGINS تنظیم شده"

msgid "Cancelling unpaid orders"
msgstr "لغو سفارش‌های پرداخت‌نشده"

#, python-format
msgid "Check: python manage.py check_plugins %(slug)s   then review and install it in the panel → Plugins."
msgstr "بررسی: python manage.py check_plugins %(slug)s   سپس در پنل ← افزونه‌ها آن را بررسی و نصب کنید."

#, python-format
msgid "Check: python manage.py check_themes %(slug)s"
msgstr "بررسی: python manage.py check_themes %(slug)s"

#, python-format
msgid "Checking the circuit breaker of plugin %s failed"
msgstr "بررسی قطع‌کنندهٔ مدار افزونه %s ناموفق بود"

msgid "Checks deployment readiness (configuration, security, migrations, paths). Exits with code 1 on errors."
msgstr "بررسی آمادگی استقرار (پیکربندی، امنیت، مهاجرت‌ها، مسیرها). با خطا کد خروج ۱ می‌دهد."

msgid "Checks the available plugins (manifest, compatibility, fingerprint). No code is run."
msgstr "افزونه‌های موجود را بررسی می‌کند (manifest، سازگاری، اثرانگشت). هیچ کدی اجرا نمی‌شود."

msgid "Checks the installed themes against the theme contract (theme.json, required files, allowed tags)."
msgstr "قالب‌های نصب‌شده را بر اساس قرارداد قالب (theme.json، فایل‌های الزامی، تگ‌های مجاز) بررسی می‌کند."

msgid "Client IP detection: no problem seen (for a live check open the “Site health” page through the domain)"
msgstr "تشخیص IP کلاینت: مشکلی دیده نشده (برای بررسی زنده صفحهٔ «سلامت سایت» را از طریق دامنه باز کنید)"

msgid "Confirm that the rollback destroys data created after the upgrade"
msgstr "تأیید اینکه بازگشت، داده‌های بعد از ارتقا را از بین می‌برد"

#, python-format
msgid "Content fingerprint: %(a1)s"
msgstr "اثرانگشت محتوا: %(a1)s"

msgid "Cookies are Secure"
msgstr "کوکی‌ها Secure هستند"

msgid "Cookies are not Secure"
msgstr "کوکی‌ها Secure نیستند"

msgid "Creates a new theme from the default theme (themes/<slug>) to make starting easy."
msgstr "یک قالب جدید را از روی قالب پیش‌فرض می‌سازد (themes/<slug>) تا شروع کار ساده باشد."

msgid "Creates a signing key pair: the private key goes to --out (600), the public key is printed."
msgstr "جفت‌کلید امضا می‌سازد: کلید خصوصی در --out (600)، کلید عمومی چاپ می‌شود."

msgid "Creates the skeleton of a new plugin in the first RAVIX_PLUGIN_DIRS folder."
msgstr "اسکلت یک افزونهٔ جدید را در اولین پوشهٔ RAVIX_PLUGIN_DIRS می‌سازد."

msgid "Creating the sample content failed"
msgstr "ساخت محتوای نمونه ناموفق بود"

#, python-format
msgid "DATABASE_URL with the scheme “%(a1)s” is not supported."
msgstr "DATABASE_URL با scheme «%(a1)s» پشتیبانی نمی‌شود."

msgid "DEBUG is off"
msgstr "DEBUG خاموش است"

msgid "DEBUG is on"
msgstr "DEBUG روشن است"

msgid "DEBUG is on; no token is needed."
msgstr "DEBUG روشن است؛ توکن لازم نیست."

msgid "DJANGO_ALLOWED_HOSTS must be set in production."
msgstr "DJANGO_ALLOWED_HOSTS باید در محیط تولید تنظیم شود."

msgid "DJANGO_SECRET_KEY must be set and at least 32 characters long."
msgstr "DJANGO_SECRET_KEY باید تنظیم شده و حداقل ۳۲ کاراکتر باشد."

msgid "Daily backup"
msgstr "پشتیبان‌گیری روزانه"

#, python-format
msgid "Database connection failed: %(exc)s"
msgstr "اتصال به دیتابیس ناموفق: %(exc)s"

msgid "Deletes events older than N days (default 90)."
msgstr "رویدادهای قدیمی‌تر از N روز (پیش‌فرض ۹۰) را حذف می‌کند."

msgid "Destination folder (default: RAVIX_PLUGIN_INSTALL_DIR)"
msgstr "پوشهٔ مقصد (پیش‌فرض: RAVIX_PLUGIN_INSTALL_DIR)"

#, python-format
msgid "Disabling the plugin %s failed"
msgstr "غیرفعال‌سازی افزونه %s ناموفق بود"

msgid "Display name of the theme"
msgstr "نام نمایشی قالب"

msgid "Downloads a plugin from the registry, verifies integrity and signature, and places it in the install folder (does not install it)."
msgstr "افزونه را از مخزن دریافت، تمامیت و امضا را بررسی و در پوشهٔ نصب قرار می‌دهد (نصب نمی‌کند)."

#, python-format
msgid "Duplicate theme “%s” in %s was ignored."
msgstr "قالب تکراری «%s» در %s نادیده گرفته شد."

msgid "EMAIL_BACKEND is the console one; no email is sent"
msgstr "EMAIL_BACKEND کنسولی است؛ ایمیلی ارسال نمی‌شود"

#, python-format
msgid "Email sending rate limit (%s) was triggered for IP %s."
msgstr "محدودیت نرخ ارسال ایمیل (%s) برای IP %s فعال شد."

msgid "Expected hash (from the Directory page) for an independent check"
msgstr "هش مورد انتظار (از صفحهٔ Directory) برای بررسی مستقل"

msgid "Fetch and validate completely without changing files"
msgstr "دریافت و اعتبارسنجی کامل بدون تغییر فایل‌ها"

#, python-format
msgid "Fetching the registry versions failed: %s"
msgstr "دریافت نسخه‌های مخزن ناموفق بود: %s"

msgid "Finds pages and posts whose slug is a language code (fa, en, de …), renames them with a suffix (for example de-page), creates a 301 redirect and records it in the audit log. --dry-run only reports."
msgstr "برگه‌ها و نوشته‌هایی را که نامکشان کد زبان است (fa، en، de …) پیدا و با پسوند (مثلاً de-page) عوض می‌کند، ریدایرکت ۳۰۱ می‌سازد و در لاگ ممیزی ثبت می‌کند. --dry-run فقط گزارش می‌دهد."

msgid "HSTS is enabled"
msgstr "HSTS فعال است"

msgid "HSTS is off"
msgstr "HSTS خاموش است"

msgid "HTTPS redirect is enabled"
msgstr "ریدایرکت HTTPS فعال است"

msgid "In production DATABASE_URL must point to a PostgreSQL database."
msgstr "در محیط تولید باید DATABASE_URL به یک PostgreSQL اشاره کند."

msgid "Install without the web (for scripts/Docker): runs migrations and creates the superadmin and initial settings. The password comes only from an environment variable (--password-env) or an interactive prompt; never from a command-line argument."
msgstr "نصب بدون وب (برای اسکریپت‌ها/Docker): مهاجرت‌ها را اجرا و مدیرکل و تنظیمات اولیه را می‌سازد. رمز عبور فقط از متغیر محیطی (--password-env) یا پرسش تعاملی؛ هرگز از آرگومان خط فرمان."

msgid "Installation complete."
msgstr "نصب کامل شد."

msgid "Installation failed"
msgstr "نصب ناموفق بود"

msgid "Installation has already been done."
msgstr "نصب قبلاً انجام شده است."

msgid "Installation has already been done; no token is needed."
msgstr "نصب قبلاً انجام شده؛ توکنی لازم نیست."

#, python-format
msgid "Key id: %(a1)s"
msgstr "شناسهٔ کلید: %(a1)s"

msgid "Local development only: allow http"
msgstr "فقط توسعهٔ محلی: اجازهٔ http"

msgid "Minimum source version"
msgstr "کمترین نسخهٔ مبدأ"

msgid "Name of the environment variable that holds the password"
msgstr "نام متغیر محیطی که رمز عبور را دارد"

#, python-format
msgid ""
"Needs recovery: run #%(a1)s\n"
"%(a2)s"
msgstr ""
"نیازمند بازیابی: اجرا #%(a1)s\n"
"%(a2)s"

#, python-format
msgid "New version: %(a1)s (current %(a2)s)"
msgstr "نسخهٔ جدید: %(a1)s (فعلی %(a2)s)"

msgid "Next step: in the panel “Plugins”, review the details and files and install it with explicit approval. Nothing was installed or enabled automatically."
msgstr "گام بعد: در پنل «افزونه‌ها» مشخصات و فایل‌ها را بازبینی و با تأیید صریح نصب کنید. نصب/فعال‌سازی خودکار انجام نشد."

msgid "No page or post has a language code as its slug"
msgstr "نامک هیچ برگه یا نوشته‌ای کد زبان نیست"

msgid "No page or post has a language code as its slug."
msgstr "نامک هیچ برگه یا نوشته‌ای کد زبان نیست."

msgid "No plugin with this name was found."
msgstr "افزونه‌ای با این نام پیدا نشد."

msgid "No signing key was given: --key-file or RAVIX_RELEASE_SIGNING_KEY (or --no-sign)."
msgstr "کلید امضا داده نشد: --key-file یا RAVIX_RELEASE_SIGNING_KEY (یا --no-sign)."

msgid "No theme was found in the RAVIX_THEME_DIRS paths."
msgstr "هیچ قالبی در مسیرهای RAVIX_THEME_DIRS پیدا نشد."

msgid "No trusted key is defined; a signed package is not accepted"
msgstr "هیچ کلید مورد اعتمادی تعریف نشده؛ بستهٔ امضاشده پذیرفته نمی‌شود"

msgid "No update source (RAVIX_UPDATE_URL) is configured; checking for new versions is disabled"
msgstr "منبع به‌روزرسانی (RAVIX_UPDATE_URL) تنظیم نشده؛ بررسی نسخهٔ جدید غیرفعال است"

msgid "No update source is configured (RAVIX_UPDATE_URL or RAVIX_UPDATE_DIR)."
msgstr "منبع به‌روزرسانی تنظیم نشده است (RAVIX_UPDATE_URL یا RAVIX_UPDATE_DIR)."

msgid "No upgrade needs recovery"
msgstr "هیچ ارتقای نیازمند بازیابی نیست"

msgid "Old environment variables are in use: "
msgstr "متغیرهای محیطی قدیمی استفاده شده‌اند: "

#, python-format
msgid ""
"Package built: %(a1)s (sha256 %(a2)s…, %(signed_label)s)\n"
"Index: %(path)s"
msgstr ""
"بسته ساخته شد: %(a1)s (sha256 %(a2)s…، %(signed_label)s)\n"
"فهرست: %(path)s"

msgid "Path of the private key file (outside the code repository!)"
msgstr "مسیر فایل کلید خصوصی (خارج از مخزن کد!)"

#, python-format
msgid "Payment mismatch %s: %s"
msgstr "مغایرت پرداخت %s: %s"

#, python-format
msgid "Plugin error %s (%s): %r"
msgstr "خطای افزونه %s (%s): %r"

msgid "Plugin installation from the web is on (RAVIX_PLUGIN_WEB_INSTALL); keep it on only if you need it, because a plugin is executable code"
msgstr "نصب افزونه از طریق وب روشن است (RAVIX_PLUGIN_WEB_INSTALL)؛ فقط اگر لازم دارید روشن بماند، چون افزونه کد قابل اجراست"

msgid "Plugin safe mode is off"
msgstr "حالت امن افزونه‌ها خاموش است"

msgid "Plugin safe mode is on (no plugin runs)"
msgstr "حالت امن افزونه‌ها روشن است (هیچ افزونه‌ای اجرا نمی‌شود)"

msgid "Prints the install token of the /install/ page (creates one if there is none). Prints nothing after installation."
msgstr "توکن نصب صفحهٔ /install/ را چاپ می‌کند (اگر نبود می‌سازد). پس از نصب چیزی چاپ نمی‌شود."

msgid "Private key seed file (permissions 600)"
msgstr "فایل seed کلید خصوصی (مجوز 600)"

msgid "Private key seed file (permissions 600) — or the environment variable RAVIX_RELEASE_SIGNING_KEY"
msgstr "فایل seed کلید خصوصی (مجوز ۶۰۰) — یا متغیر محیطی RAVIX_RELEASE_SIGNING_KEY"

#, python-format
msgid ""
"Private key written to %(kf)s (permissions 600; keep it and make a safe backup). Key id (key_id; for revocation): %(key_id)s\n"
"Public key (for apps/core/official.py or RAVIX_TRUSTED_PUBLIC_KEYS; the last line):\n"
"%(pub)s"
msgstr ""
"کلید خصوصی در %(kf)s نوشته شد (مجوز ۶۰۰؛ آن را نگه‌داری و پشتیبان امن کنید). شناسهٔ کلید (key_id؛ برای ابطال): %(key_id)s\n"
"کلید عمومی (برای apps/core/official.py یا RAVIX_TRUSTED_PUBLIC_KEYS؛ آخرین خط):\n"
"%(pub)s"

#, python-format
msgid "Private key written: %(path)s (permissions 600; keep a safe backup, it cannot be recovered)"
msgstr "کلید خصوصی نوشته شد: %(path)s (مجوز 600؛ پشتیبان امن بگیرید، قابل بازیابی نیست)"

#, python-format
msgid "Public key (to register on sites): %(pub)s"
msgstr "کلید عمومی (برای ثبت در سایت‌ها): %(pub)s"

msgid "Publishes scheduled posts whose publish time has come."
msgstr "نوشته‌های زمان‌بندی‌شده‌ای که زمان انتشارشان رسیده را منتشر می‌کند."

msgid "Publishing scheduled posts"
msgstr "انتشار نوشته‌های زمان‌بندی‌شده"

msgid "Python range such as >=3.11"
msgstr "بازهٔ Python مثل >=3.11"

msgid "RAVIX_PLUGINS_ALLOW_UNSIGNED is on; local upload without a signature is allowed"
msgstr "RAVIX_PLUGINS_ALLOW_UNSIGNED روشن است؛ آپلود محلی بدون امضا مجاز است"

msgid "RAVIX_PLUGIN_DIRS is empty."
msgstr "RAVIX_PLUGIN_DIRS خالی است."

msgid "RAVIX_SECRETS_KEY is not set (required before adding a gateway key)"
msgstr "RAVIX_SECRETS_KEY تنظیم نشده (پیش از افزودن کلید درگاه لازم است)"

msgid "RAVIX_SECRETS_KEY is not set; gateway keys cannot be stored or read safely"
msgstr "RAVIX_SECRETS_KEY تنظیم نشده؛ کلیدهای درگاه قابل نگهداری/خواندن امن نیستند"

#, python-format
msgid "RAVIX_SHOP_PRIVATE_ROOT (%(priv)s) is inside the public media; digital files would leak"
msgstr "RAVIX_SHOP_PRIVATE_ROOT (%(priv)s) داخل media عمومی است؛ فایل‌های دیجیتال لو می‌روند"

msgid "RAVIX_THEME_DIRS is empty."
msgstr "RAVIX_THEME_DIRS خالی است."

#, python-format
msgid "RAVIX_TRUSTED_PROXIES contains an invalid entry: %(bad_proxies)s"
msgstr "RAVIX_TRUSTED_PROXIES شامل ورودی نامعتبر است: %(bad_proxies)s"

msgid "RAVIX_TRUSTED_PROXIES is valid"
msgstr "RAVIX_TRUSTED_PROXIES معتبر است"

#, python-format
msgid "RAVIX_TRUSTED_PUBLIC_KEYS contains an invalid entry: %(bad_keys)s"
msgstr "RAVIX_TRUSTED_PUBLIC_KEYS شامل ورودی نامعتبر است: %(bad_keys)s"

msgid "RAVIX_TRUST_PROXY_HEADERS has been removed and has no effect; nothing is needed behind a Unix socket, and for a proxy over TCP use RAVIX_TRUSTED_PROXIES"
