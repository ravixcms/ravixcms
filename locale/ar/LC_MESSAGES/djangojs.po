msgstr "اسحب للنقل"

#: static/builder/builder.js
msgid "Move %(type)s"
msgstr "نقل %(type)s"

#: static/builder/builder.js
msgid "Previous column"
msgstr "العمود السابق"

#: static/builder/builder.js
msgid "Up"
msgstr "أعلى"

#: static/builder/builder.js
msgid "Next column"
msgstr "العمود التالي"

#: static/builder/builder.js
msgid "Down"
msgstr "أسفل"

