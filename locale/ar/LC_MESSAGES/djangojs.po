msgid "bold text"
msgstr "نص غامق"

#: static/js/ravix.js
msgid "italic text"
msgstr "نص مائل"

#: static/js/ravix.js
msgid "code"
msgstr "شيفرة"

#: static/js/ravix.js
msgid "link text"
msgstr "نص الرابط"

#: static/js/ravix.js
msgid "image description"
msgstr "وصف الصورة"

#: static/js/ravix.js
msgid "Nothing to preview."
msgstr "لا شيء للمعاينة."

#: static/js/ravix.js
msgid "Preview is not available."
msgstr "المعاينة غير متاحة."

#: static/js/ravix.js
msgid "%(n)s of %(max)s characters"
msgstr "%(n)s من %(max)s حرفًا"

#: static/js/ravix.js
