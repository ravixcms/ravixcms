msgid "Duplicate"
msgstr "تكرار"

#: static/builder/builder.js
msgid "Delete"
msgstr "حذف"

#: static/builder/builder.js
msgid "(empty heading)"
msgstr "(عنوان فارغ)"

#: static/builder/builder.js
msgid "(empty text)"
msgstr "(نص فارغ)"

#: static/builder/builder.js
msgid "Image not found"
msgstr "الصورة غير موجودة"

#: static/builder/builder.js static/js/ravix.js
msgid "Loading…"
msgstr "جارٍ التحميل…"

#: static/builder/builder.js
msgid "No image selected — select this element and choose an image"
msgstr "لم تُحدَّد صورة — حدّد هذا العنصر واختر صورة"

#: static/builder/builder.js
msgid "(button)"
msgstr "(زر)"

#: static/builder/builder.js
msgid "Drag an element from the side panel and drop it here"
msgstr "اسحب عنصرًا من اللوحة الجانبية وأفلته هنا"

#: static/builder/builder.js
msgid "Drag a row from the side panel and drop it here"
msgstr "اسحب صفًّا من اللوحة الجانبية وأفلته هنا"

#: static/builder/builder.js
msgid "The page is empty."
msgstr "الصفحة فارغة."

#: static/builder/builder.js
msgid "Drag a “Section” from the side panel and drop it here, or click it."
msgstr "اسحب «قسمًا» من اللوحة الجانبية وأفلته هنا، أو انقر عليه."

#: static/builder/builder.js
msgid "You have reached the limit for the number of %(what)s in this section."
msgstr "بلغت الحد الأقصى لعدد %(what)s في هذا القسم."

#: static/builder/builder.js
msgid "element"
msgstr "عنصر"

#: static/builder/builder.js
msgid "The page has become too large."
msgstr "أصبحت الصفحة كبيرة جدًا."

#: static/builder/builder.js
msgid "First select a section."
msgstr "حدّد قسمًا أولًا."

#: static/builder/builder.js
msgid "First select a column."
msgstr "حدّد عمودًا أولًا."

#: static/builder/builder.js
msgid "First select a column (or an element inside a column)."
msgstr "حدّد عمودًا أولًا (أو عنصرًا داخل عمود)."

#: static/builder/builder.js
msgid "You have reached the limit."
msgstr "بلغت الحد الأقصى."

#: static/builder/builder.js
msgid "To add a column use the row settings."
msgstr "لإضافة عمود استخدم إعدادات الصف."

#: static/builder/builder.js
msgid "A row must have at least one column; delete the row itself."
msgstr "يجب أن يحتوي الصف على عمود واحد على الأقل؛ احذف الصف نفسه."

#: static/builder/builder.js
msgid "1-column row"
msgstr "صف بعمود واحد"

#: static/builder/builder.js
msgid "%(n)s-column row"
msgstr "صف من %(n)s أعمدة"

#: static/builder/builder.js
msgid "Default"
msgstr "الافتراضي"

#: static/builder/builder.js
msgid "%(label)s (picker)"
msgstr "%(label)s (منتقي)"

#: static/builder/builder.js
msgid "The hex color is not valid (e.g. #1d4ed8)."
msgstr "اللون السداسي غير صالح (مثال: #1d4ed8)."

#: static/builder/builder.js
msgid "Change image"
msgstr "تغيير الصورة"

#: static/builder/builder.js
msgid "Choose from library"
msgstr "اختيار من المكتبة"

#: static/builder/builder.js
msgid "Remove image"
msgstr "إزالة الصورة"

#: static/builder/builder.js
msgid "/about/  or  https://…"
msgstr "/about/  أو  https://…"

#: static/builder/builder.js
msgid ""
"The address is not allowed; use an internal path (/…), http(s), mailto or "
"tel."
msgstr ""
"العنوان غير مسموح به؛ استخدم مسارًا داخليًا (/…) أو http(s) أو mailto أو "
"tel."

#: static/builder/builder.js
msgid "Page settings"
msgstr "إعدادات الصفحة"

#: static/builder/builder.js
msgid "To edit, click a section, row, column or element on the canvas."
msgstr "للتعديل، انقر على قسم أو صف أو عمود أو عنصر في اللوحة."

#: static/builder/builder.js
msgid "General"
msgstr "عام"

#: static/builder/builder.js
msgid "Selection path"
msgstr "مسار التحديد"

#: static/builder/builder.js
msgid "%(type)s settings"
msgstr "إعدادات %(type)s"

#: static/builder/builder.js
msgid "Content"
msgstr "المحتوى"

#: static/builder/builder.js
msgid "Layout and spacing"
msgstr "التخطيط والمسافات"

#: static/builder/builder.js
msgid "Appearance"
msgstr "المظهر"

#: static/builder/builder.js
msgid "+ Add column"
msgstr "+ إضافة عمود"

#: static/builder/builder.js
msgid "At most %(n)s columns per row."
msgstr "%(n)s أعمدة كحد أقصى في الصف."

#: static/builder/builder.js
msgid "Split columns equally"
msgstr "تقسيم الأعمدة بالتساوي"

#: static/builder/builder.js
msgid "Total width of this row’s columns: %(total)s of 12"
msgstr "العرض الإجمالي لأعمدة هذا الصف: %(total)s من 12"

#: static/builder/builder.js
msgid "No image found. First upload an image to the media library."
msgstr "لم تُعثر على أي صورة. ارفع صورة أولًا إلى مكتبة الوسائط."

#: static/builder/builder.js
msgid "Saved."
msgstr "تم الحفظ."

#: static/builder/builder.js
msgid "Publish"
msgstr "نشر"

#: static/builder/builder.js
msgid "Submit for approval"
msgstr "إرسال للموافقة"

#: static/builder/builder.js
msgid "Publish this layout on the site"
msgstr "انشر هذا التخطيط على الموقع"

#: static/builder/builder.js
msgid "The layout is sent to an administrator for approval"
msgstr "يُرسل التخطيط إلى مدير للموافقة عليه"

#: static/builder/builder.js
msgid "Saving the draft must succeed first."
msgstr "يجب أن ينجح حفظ المسودة أولًا."

#: static/builder/builder.js
msgid "Publish layout"
msgstr "نشر التخطيط"

#: static/builder/builder.js
msgid ""
"The current draft replaces the page content on the site. (The page’s own "
"status — published or draft — is controlled in the “Pages” section.)"
msgstr ""
"تحلّ المسودة الحالية محل محتوى الصفحة في الموقع. (حالة الصفحة نفسها — منشورة"
" أو مسودة — تُضبط من قسم «الصفحات».)"

#: static/builder/builder.js
msgid "The layout was published."
msgstr "نُشر التخطيط."

#: static/builder/builder.js
msgid ""
"It will be published on the site after an administrator approves it. Until "
"then the current page is shown."
msgstr ""
"سيُنشر على الموقع بعد موافقة المدير. وإلى ذلك الحين تُعرض الصفحة الحالية."

#: static/builder/builder.js
msgid "Submitted for approval."
msgstr "أُرسل للموافقة."

#: static/builder/builder.js
msgid "The version was saved."
msgstr "حُفظت النسخة."

#: static/builder/builder.js
msgid "Unpublish the layout? The page goes back to its previous text content."
msgstr "هل تريد إلغاء نشر التخطيط؟ تعود الصفحة إلى محتواها النصي السابق."

#: static/builder/builder.js
msgid "The layout was unpublished."
msgstr "أُلغي نشر التخطيط."

#: static/builder/builder.js
msgid "No version has been saved yet."
msgstr "لم تُحفظ أي نسخة بعد."

#: static/builder/builder.js
msgid "Published"
msgstr "منشور"

#: static/builder/builder.js
msgid "Automatic"
msgstr "تلقائي"

#: static/builder/builder.js
msgid "Version %(n)s"
msgstr "النسخة %(n)s"

#: static/builder/builder.js
msgid " (reviewer: %(note)s)"
msgstr " (المراجع: %(note)s)"

#: static/builder/builder.js
msgid "Preview"
msgstr "معاينة"

#: static/builder/builder.js
msgid "Restore"
msgstr "استرجاع"

#: static/builder/builder.js
msgid ""
"Replace the current draft with version %(n)s? An automatic version of the "
"current state will be saved."
msgstr ""
"استبدال المسودة الحالية بالنسخة %(n)s؟ ستُحفظ نسخة تلقائية من الحالة "
"الحالية."

#: static/builder/builder.js
msgid "Version %(n)s was restored to the draft."
msgstr "استُرجعت النسخة %(n)s إلى المسودة."

#: static/builder/builder.js
msgid "Approve and publish"
msgstr "الموافقة والنشر"

#: static/builder/builder.js
msgid "Approved and published."
msgstr "تمت الموافقة والنشر."

#: static/builder/builder.js
msgid "Reject"
msgstr "رفض"

#: static/builder/builder.js
msgid "Reason for rejection (optional):"
msgstr "سبب الرفض (اختياري):"

#: static/builder/builder.js
msgid "The version was rejected."
msgstr "رُفضت النسخة."

#: static/builder/builder.js
msgid "Loading failed"
msgstr "فشل التحميل"

#: static/builder/builder.js
msgid "Ready"
msgstr "جاهز"

#: static/js/ravix.js
msgid "Hide password"
msgstr "إخفاء كلمة المرور"

#: static/js/ravix.js
msgid "Show password"
msgstr "إظهار كلمة المرور"

#: static/js/ravix.js
msgid "The file is larger than the allowed limit."
msgstr "الملف أكبر من الحد المسموح."

#: static/js/ravix.js
msgid "Choose files"
msgstr "اختيار ملفات"

#: static/js/ravix.js
msgid "Choose file"
msgstr "اختيار ملف"

#: static/js/ravix.js
msgid "No files chosen"
msgstr "لم يتم اختيار أي ملفات"

#: static/js/ravix.js
msgid "No file chosen"
msgstr "لم يتم اختيار أي ملف"

#: static/js/ravix.js
msgid "Files selected: %(n)s"
msgstr "الملفات المحددة: %(n)s"

#: static/js/ravix.js
msgid "This file type is not accepted here."
msgstr "نوع هذا الملف غير مقبول هنا."

#: static/js/ravix.js
msgid "Drop the files here"
msgstr "أفلت الملفات هنا"

#: static/js/ravix.js
