#, python-format
msgid "Theme ZIP install — %(kind)s: %(text)s"
msgstr "تثبيت قالب من ZIP — %(kind)s: %(text)s"

#: apps/themes/installer.py
msgid ""
"Installing themes from the web is turned off on this server. The server "
"administrator must deliberately set RAVIX_THEME_WEB_INSTALL=true (guide: "
"docs/themes.md)."
msgstr ""
"تثبيت القوالب من الويب معطّل على هذا الخادم. يجب على مدير الخادم ضبط "
"RAVIX_THEME_WEB_INSTALL=true عن قصد (الدليل: docs/themes.md)."

#: apps/themes/installer.py
msgid "Only the superadmin may install themes."
msgstr "يمكن للمدير الأعلى فقط تثبيت القوالب."

#: apps/themes/installer.py
msgid ""
"The theme install folder could not be created or is not writable; check "
"RAVIX_THEME_INSTALL_DIR and its permissions."
msgstr ""
"تعذّر إنشاء مجلد تثبيت القوالب أو أنه غير قابل للكتابة؛ افحص "
"RAVIX_THEME_INSTALL_DIR وصلاحياته."

#: apps/themes/installer.py
msgid ""
"The theme install folder is not writable; check RAVIX_THEME_INSTALL_DIR and "
"its permissions."
msgstr ""
"مجلد تثبيت القوالب غير قابل للكتابة؛ افحص RAVIX_THEME_INSTALL_DIR وصلاحياته."

#: apps/themes/installer.py
#, python-format
msgid ""
"The install folder’s file system (%(fstype)s) has no reliable locking; the "
"install was not performed to avoid conflicts. Put the install folder on a "
"local disk."
msgstr ""
"نظام ملفات مجلد التثبيت (%(fstype)s) لا يوفر قفلًا موثوقًا؛ لم يُنفَّذ "
"التثبيت لتجنب التعارضات. ضع مجلد التثبيت على قرص محلي."

#: apps/themes/installer.py
msgid ""
"The install lock file could not be created; check the install folder "
"permissions."
msgstr "تعذّر إنشاء ملف قفل التثبيت؛ افحص صلاحيات مجلد التثبيت."

#: apps/themes/installer.py
msgid "Another install is in progress right now; try again shortly."
msgstr "هناك تثبيت آخر قيد التنفيذ الآن؛ حاول مرة أخرى بعد قليل."

#: apps/themes/installer.py
msgid ""
"File-system locking is not supported on the install folder; the install was "
"not performed for safety. Put the install folder on a local disk."
msgstr ""
"قفل نظام الملفات غير مدعوم في مجلد التثبيت؛ لم يُنفَّذ التثبيت للسلامة. ضع "
"مجلد التثبيت على قرص محلي."

#: apps/themes/installer.py
msgid ""
"The default theme (“default”) cannot be replaced or overwritten this way."
msgstr ""
"لا يمكن استبدال القالب الافتراضي («default») أو الكتابة فوقه بهذه الطريقة."

#: apps/themes/installer.py
#, python-format
msgid ""
"A theme with the ID “%(slug)s” already exists and will not be overwritten. "
"Change the theme ID in theme.json and the folder name."
msgstr ""
"يوجد قالب بالمعرّف «%(slug)s» بالفعل ولن يُكتب فوقه. غيّر معرّف القالب في "
"theme.json واسم المجلد."

#: apps/themes/installer.py
msgid ""
"The temporary folder was created in an invalid place; the install was "
"cancelled."
msgstr "أُنشئ المجلد المؤقت في مكان غير صالح؛ أُلغي التثبيت."

#: apps/themes/installer.py
msgid "The theme is not compatible with the Ravix theme contract."
msgstr "القالب غير متوافق مع عقد قوالب Ravix."

#: apps/themes/installer.py
msgid "The destination path is invalid; the install was cancelled."
msgstr "مسار الوجهة غير صالح؛ أُلغي التثبيت."

#: apps/themes/installer.py
msgid "The final placement of the theme failed and no changes were applied."
msgstr "فشل الوضع النهائي للقالب ولم يُطبَّق أي تغيير."

#: apps/themes/installer.py
msgid "The final validation after install failed; the install was cancelled."
msgstr "فشل التحقق النهائي بعد التثبيت؛ أُلغي التثبيت."

#: apps/themes/installer.py
msgid "Start"
msgstr "بدء"

#: apps/themes/installer.py
#, python-format
msgid "Request received (size %(value)s KB)."
msgstr "استُلم الطلب (الحجم %(value)s كيلوبايت)."

#: apps/themes/installer.py apps/themes/package.py
msgid "No file was sent or the file is empty."
msgstr "لم يُرسل أي ملف أو أن الملف فارغ."

#: apps/themes/installer.py apps/themes/package.py
#, python-format
msgid "The file is larger than %(value)s MB."
msgstr "الملف أكبر من %(value)s ميغابايت."

#: apps/themes/installer.py
msgid "Security rejection"
msgstr "رفض أمني"

#: apps/themes/installer.py apps/themes/views.py
msgid "Was rejected"
msgstr "رُفض"

#: apps/themes/installer.py
msgid "Internal error"
msgstr "خطأ داخلي"

#: apps/themes/installer.py
msgid ""
"The install stopped with an unexpected error; the details are only in the "
"server log and no changes were applied."
msgstr ""
"توقف التثبيت بسبب خطأ غير متوقع؛ التفاصيل في سجل الخادم فقط ولم يُطبَّق أي "
"تغيير."

#: apps/themes/installer.py
msgid ""
"An unexpected error occurred and no changes were applied; the server "
"administrator can see the details in the logs."
msgstr ""
"حدث خطأ غير متوقع ولم يُطبَّق أي تغيير؛ يمكن لمدير الخادم رؤية التفاصيل في "
"السجلات."

#: apps/themes/installer.py
#, python-format
msgid ""
"Theme “%(slug)s” version %(value)s was installed (%(file_count)s files); it "
"was not activated."
msgstr ""
"ثُبّت القالب «%(slug)s» الإصدار %(value)s (%(file_count)s ملفات)؛ ولم "
"يُفعَّل."

#: apps/themes/manifest.py
#, python-format
msgid "The field “%(key)s” is required in theme.json."
msgstr "الحقل «%(key)s» مطلوب في theme.json."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The field “%(key)s” must be a string of at most %(max_len)s characters."
msgstr "يجب أن يكون الحقل «%(key)s» نصًا من %(max_len)s حرفًا كحد أقصى."

#: apps/themes/manifest.py
#, python-format
msgid "File or folder not allowed in the theme root: “%(name)s”."
msgstr "ملف أو مجلد غير مسموح به في جذر القالب: «%(name)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(relative_to)s”."
msgstr "الروابط الرمزية غير مسموح بها: «%(relative_to)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Symbolic links are not allowed: “%(rel)s”."
msgstr "الروابط الرمزية غير مسموح بها: «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The file type of “%(rel)s” is not allowed in a theme (only files that cannot"
" run on the server)."
msgstr ""
"نوع الملف «%(rel)s» غير مسموح به في القالب (فقط الملفات التي لا يمكن تشغيلها"
" على الخادم)."

#: apps/themes/manifest.py
#, python-format
msgid "The templates folder accepts only html files: “%(rel)s”."
msgstr "يقبل مجلد القوالب ملفات html فقط: «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The locale folder accepts only <language>.json files for the supported "
"languages (for example fr.json or pt-br.json): “%(rel)s”."
msgstr ""
"يقبل مجلد locale ملفات <language>.json فقط للغات المدعومة (مثل fr.json أو "
"pt-br.json): «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid ""
"The translation file “%(rel)s” must be a JSON object that maps English text "
"to its translation (text only, within the size limits)."
msgstr ""
"يجب أن يكون ملف الترجمة «%(rel)s» كائن JSON يربط النص الإنجليزي بترجمته "
"(نصوص فقط وضمن حدود الحجم المسموح بها)."

#: apps/themes/manifest.py
#, python-format
msgid ""
"html files are not allowed in the static folder: “%(rel)s” (html templates "
"must be in templates)."
msgstr ""
"ملفات html غير مسموح بها في مجلد static: «%(rel)s» (يجب أن تكون قوالب html "
"في templates)."

#: apps/themes/manifest.py
#, python-format
msgid "The size of file “%(rel)s” exceeds the limit."
msgstr "حجم الملف «%(rel)s» يتجاوز الحد."

#: apps/themes/manifest.py apps/themes/package.py
#, python-format
msgid "The number of theme files exceeds %(MAX_FILES)s."
msgstr "عدد ملفات القالب يتجاوز %(MAX_FILES)s."

#: apps/themes/manifest.py
#, python-format
msgid "The required template “%(name)s” does not exist."
msgstr "القالب المطلوب «%(name)s» غير موجود."

#: apps/themes/manifest.py
#, python-format
msgid "The file “%(rel)s” must be valid UTF-8 text."
msgstr "يجب أن يكون الملف «%(rel)s» نصًا UTF-8 صالحًا."

#: apps/themes/manifest.py
#, python-format
msgid ""
"Loading the library “%(lib)s” in “%(rel)s” is not allowed (only ravix_theme "
"and i18n)."
msgstr ""
"تحميل المكتبة «%(lib)s» في «%(rel)s» غير مسموح (فقط ravix_theme وi18n)."

#: apps/themes/manifest.py
#, python-format
msgid "The {%% debug %%} tag is not allowed in “%(rel)s”."
msgstr "الوسم {%% debug %%} غير مسموح به في «%(rel)s»."

#: apps/themes/manifest.py
#, python-format
msgid "Syntax error in “%(rel)s”: %(exc)s"
msgstr "خطأ في البنية في «%(rel)s»: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid "base.html must use the {%% %(tag)s %%} tag."
msgstr "يجب أن يستخدم base.html الوسم {%% %(tag)s %%}."

#: apps/themes/manifest.py
msgid ""
"The theme folder name may only contain lowercase English letters, digits, "
"“-” and “_”."
msgstr ""
"لا يجوز أن يحتوي اسم مجلد القالب إلا على أحرف إنجليزية صغيرة وأرقام و«-» "
"و«_»."

#: apps/themes/manifest.py
msgid "The theme folder cannot be a symbolic link."
msgstr "لا يمكن أن يكون مجلد القالب رابطًا رمزيًا."

#: apps/themes/manifest.py
msgid "The theme.json file was not found."
msgstr "لم يُعثر على ملف theme.json."

#: apps/themes/manifest.py
msgid "theme.json cannot be a symbolic link."
msgstr "لا يمكن أن يكون theme.json رابطًا رمزيًا."

#: apps/themes/manifest.py
msgid "The size of theme.json exceeds the limit."
msgstr "حجم theme.json يتجاوز الحد."

#: apps/themes/manifest.py
msgid "theme.json must be a JSON object."
msgstr "يجب أن يكون theme.json كائن JSON."

#: apps/themes/manifest.py
#, python-format
msgid "theme.json is not valid: %(exc)s"
msgstr "theme.json غير صالح: %(exc)s"

#: apps/themes/manifest.py
#, python-format
msgid ""
"api_version must be %(API_VERSION)s (the theme was built for another version"
" of the contract)."
msgstr ""
"يجب أن يكون api_version هو %(API_VERSION)s (بُني القالب لإصدار آخر من "
"العقد)."

#: apps/themes/manifest.py
msgid ""
"The “slug” value in theme.json must match the theme folder name exactly."
msgstr "يجب أن تطابق قيمة «slug» في theme.json اسم مجلد القالب تمامًا."

#: apps/themes/manifest.py
msgid "“version” must be in semantic versioning form (e.g. 1.0.0)."
msgstr "يجب أن يكون «version» بصيغة الإصدار الدلالي (مثل 1.0.0)."

#: apps/themes/manifest.py
msgid "“ravix” must be a version range (e.g. >=0.6,<1.0)."
msgstr "يجب أن يكون «ravix» نطاق إصدارات (مثل >=0.6,<1.0)."

#: apps/themes/manifest.py
msgid ""
"The “screenshot” path is invalid (it must be a png/jpg/webp file inside "
"static)."
msgstr ""
"مسار «screenshot» غير صالح (يجب أن يكون ملف png/jpg/webp داخل static)."

#: apps/themes/manifest.py
msgid "The templates folder does not exist."
msgstr "مجلد القوالب غير موجود."

#: apps/themes/manifest.py
msgid "The theme folder does not exist."
msgstr "مجلد القالب غير موجود."

