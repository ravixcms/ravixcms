#: apps/themes/package.py
#, python-format
msgid "Absolute paths are not allowed in ZIP: “%(show)s”."
msgstr "المسارات المطلقة غير مسموح بها في ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Unsafe path in ZIP (. or .. or an empty segment): “%(show)s”."
msgstr "مسار غير آمن في ZIP (. أو .. أو مقطع فارغ): «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "The path “%(show)s” is too long or too deep."
msgstr "المسار «%(show)s» طويل جدًا أو عميق جدًا."

#: apps/themes/package.py
#, python-format
msgid ""
"The name “%(show)s” is not allowed; file and folder names may only contain "
"English letters, digits, “.”, “-” and “_” (no spaces, no Persian characters,"
" no leading dot)."
msgstr ""
"الاسم «%(show)s» غير مسموح به؛ يجوز أن تحتوي أسماء الملفات والمجلدات على "
"أحرف إنجليزية وأرقام و«.» و«-» و«_» فقط (بلا مسافات ولا أحرف فارسية ولا نقطة"
" في البداية)."

#: apps/themes/package.py
#, python-format
msgid "A file without an extension is not allowed: “%(show)s”."
msgstr "الملف بلا امتداد غير مسموح به: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"An executable or script file is not allowed in a theme (such as py or php): "
"“%(show)s”."
msgstr ""
"الملف التنفيذي أو السكربت غير مسموح به في القالب (مثل py أو php): "
"«%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"SVG files are not allowed in this version: “%(show)s”. Use png, webp or jpg "
"instead."
msgstr ""
"ملفات SVG غير مسموح بها في هذا الإصدار: «%(show)s». استخدم png أو webp أو "
"jpg بدلًا منها."

#: apps/themes/package.py
#, python-format
msgid "The file extension of “%(show)s” is not allowed in a theme."
msgstr "امتداد الملف «%(show)s» غير مسموح به في القالب."

#: apps/themes/package.py
msgid "The ZIP is empty."
msgstr "ملف ZIP فارغ."

#: apps/themes/package.py
#, python-format
msgid ""
"The number of ZIP entries exceeds the limit (at most %(MAX_ZIP_ENTRIES)s)."
msgstr "عدد عناصر ZIP يتجاوز الحد (%(MAX_ZIP_ENTRIES)s كحد أقصى)."

#: apps/themes/package.py
#, python-format
msgid "Symbolic links are not allowed in ZIP: “%(show)s”."
msgstr "الروابط الرمزية غير مسموح بها في ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Special or unusual entries are not allowed in ZIP: “%(show)s”."
msgstr "العناصر الخاصة أو غير المعتادة غير مسموح بها في ZIP: «%(show)s»."

#: apps/themes/package.py
msgid "Encrypted ZIP files are not allowed."
msgstr "ملفات ZIP المشفّرة غير مسموح بها."

#: apps/themes/package.py
msgid ""
"The ZIP compression method is not supported (only Deflate or no "
"compression)."
msgstr "طريقة ضغط ZIP غير مدعومة (Deflate أو بدون ضغط فقط)."

#: apps/themes/package.py
#, python-format
msgid "Inconsistent entry in ZIP: “%(show)s”."
msgstr "عنصر غير متسق في ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid "Duplicate name (or differing only in letter case) in ZIP: “%(show)s”."
msgstr "اسم مكرر (أو يختلف فقط في حالة الأحرف) في ZIP: «%(show)s»."

#: apps/themes/package.py
#, python-format
msgid ""
"The file “%(show)s” is outside the theme folder. All files must be inside "
"one folder named after the theme ID (e.g. my-theme/theme.json)."
msgstr ""
"الملف «%(show)s» خارج مجلد القالب. يجب أن تكون جميع الملفات داخل مجلد واحد "
"باسم معرّف القالب (مثل my-theme/theme.json)."

#: apps/themes/package.py
#, python-format
msgid "The size of file “%(show)s” exceeds %(value)s MB."
msgstr "حجم الملف «%(show)s» يتجاوز %(value)s ميغابايت."

#: apps/themes/package.py
msgid "The ZIP is suspicious (a zero-size file in the compressed data)."
msgstr "ملف ZIP مشبوه (ملف بحجم صفر في البيانات المضغوطة)."

#: apps/themes/package.py
#, python-format
msgid "The compression ratio of “%(show)s” is unusual (possible zip bomb)."
msgstr "نسبة ضغط «%(show)s» غير معتادة (احتمال قنبلة zip)."

#: apps/themes/package.py
#, python-format
msgid "The total size of the extracted files exceeds %(value)s MB."
msgstr "الحجم الإجمالي للملفات المستخرجة يتجاوز %(value)s ميغابايت."

#: apps/themes/package.py
msgid ""
"The ZIP must have only one root folder (named after the theme ID). If you "
"made the ZIP on macOS, do not include the __MACOSX folder; put the files "
"inside one folder and zip again."
msgstr ""
"يجب أن يحتوي ZIP على مجلد جذر واحد فقط (باسم معرّف القالب). إذا أنشأت ZIP "
"على macOS فلا تُضمّن مجلد __MACOSX؛ ضع الملفات داخل مجلد واحد واضغطها مرة "
"أخرى."

#: apps/themes/package.py
#, python-format
msgid ""
"The root folder name (“%(show)s”) is not a valid theme ID; only lowercase "
"English letters, digits, “-” and “_” (at most 49 characters)."
msgstr ""
"اسم مجلد الجذر («%(show)s») ليس معرّف قالب صالحًا؛ أحرف إنجليزية صغيرة "
"وأرقام و«-» و«_» فقط (49 حرفًا كحد أقصى)."

#: apps/themes/package.py
msgid "Conflicting paths in ZIP (one name is both a file and a folder)."
msgstr "مسارات متعارضة في ZIP (اسم واحد هو ملف ومجلد معًا)."

#: apps/themes/package.py
msgid "The ZIP contains no files."
msgstr "لا يحتوي ZIP على أي ملفات."

#: apps/themes/package.py
msgid "Path outside the destination folder in ZIP (zip-slip)."
msgstr "مسار خارج مجلد الوجهة في ZIP (zip-slip)."

#: apps/themes/package.py
msgid ""
"The real size of the extracted files exceeds the limit (possible zip bomb)."
msgstr "الحجم الفعلي للملفات المستخرجة يتجاوز الحد (احتمال قنبلة zip)."

#: apps/themes/package.py
msgid ""
"The real size of one of the files does not match the ZIP declaration; the "
"ZIP is tampered with or corrupted."
msgstr ""
"الحجم الفعلي لأحد الملفات لا يطابق إعلان ZIP؛ ملف ZIP عُبث به أو تالف."

#: apps/themes/package.py
msgid "The ZIP file is corrupted (the compressed content is not valid)."
msgstr "ملف ZIP تالف (المحتوى المضغوط غير صالح)."

#: apps/themes/package.py
msgid "Duplicate name in ZIP."
msgstr "اسم مكرر في ZIP."

#: apps/themes/package.py
msgid ""
"Could not write to the temporary folder; check the server’s permissions and "
