#, python-format
msgid "The IP of this request was read correctly (%(ip)s)."
msgstr "تمت قراءة IP هذا الطلب بشكل صحيح (%(ip)s)."

#: apps/core/sitehealth.py
msgid "unix socket"
msgstr "مقبس يونكس"

#: apps/core/sitehealth.py
#, python-format
msgid ""
"Requests arrive from proxy %(value)s but it is not trusted; all visitors are"
" counted as one IP."
msgstr ""
"تصل الطلبات من الوكيل %(value)s لكنه غير موثوق؛ يُحتسب جميع الزوار كعنوان IP"
