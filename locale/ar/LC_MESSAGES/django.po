msgid ""
"Add proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; to the "
"proxy."
msgstr ""
"أضف proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; إلى الوكيل."

