msgstr "ملف ZIP تالف أو غير مكتمل وتعذّر فتحه."

#: apps/themes/package.py
#, python-format
msgid "Unsafe name in ZIP (backslash): “%(show)s”."
msgstr "اسم غير آمن في ZIP (شرطة مائلة عكسية): «%(show)s»."

#: apps/themes/package.py
