[Unit]
Description=Ravix - publish due scheduled posts
After=network.target postgresql.service

[Service]
Type=oneshot
User=ravix
Group=www-data
# کد برنامه (plugins/ و ...) برای install.sh مالکیت root:ravix با مجوز 750 دارد. گروه اصلی این سرویس www-data است، پس بدون SupplementaryGroups=ravix
# خواندن/فهرست‌کردن پوشهٔ plugins با PermissionError (و ۵۰۰ در /panel/plugins/) شکست می‌خورد. این خط را حذف نکنید.
SupplementaryGroups=ravix
EnvironmentFile=/etc/ravix/ravix.env
WorkingDirectory=/srv/ravix/app
ExecStart=/srv/ravix/venv/bin/python manage.py publish_scheduled
# اجرای بعدی تایمر نباید روی این یکی بیفتد؛ oneshot هم‌زمان دو بار اجرا نمی‌شود، ولی اجرای گیرکرده باید زود قطع شود.
TimeoutStartSec=55
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
