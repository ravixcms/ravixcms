[Unit]
Description=Ravin CMS - daily backup (database + files), keeps the newest 7
After=network.target postgresql.service

[Service]
Type=oneshot
User=ravin
Group=www-data
# ۷ پشتیبان آخر نگه داشته می‌شود؛ برای تغییر، KEEP_COUNT را در /etc/ravin/ravin.env بگذارید (فایل پس از این خط خوانده می‌شود).
Environment=KEEP_COUNT=7
EnvironmentFile=/etc/ravin/ravin.env
WorkingDirectory=/srv/ravin/app
ExecStart=/srv/ravin/app/deploy/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# ReadWritePaths عمداً نیامده: با ProtectSystem=full مسیر /var/backups قابل‌نوشتن است و مسیر ناموجود در ReadWritePaths سرویس را با 226/NAMESPACE نمی‌اندازد (در آزمون VPS برای ravin.service دیده شد).
